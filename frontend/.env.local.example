# Public browser configuration (required)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side speech-to-text rollout. Keep both this flag and the backend
# STT_SERVER_ENABLED flag aligned. Enable only after creating the private
# interview-audio bucket and configuring GROQ_API_KEY on the backend.
NEXT_PUBLIC_STT_SERVER_ENABLED=false

# Optional service warmup controls. The interval is clamped to at least 5 min.
NEXT_PUBLIC_AWAKE_INTERVAL_MS=600000
NEXT_PUBLIC_DISABLE_AWAKE=false

# Presentation-only launch-offer switch. Keep false to hide launch-offer UI
# without deleting historical grants, entitlement data, or backend services.
NEXT_PUBLIC_LAUNCH_OFFER_VISIBLE=false

# Presentation-only switch for the candidate-count message on login/signup.
# Keep false to hide it while preserving the remotely configured message.
NEXT_PUBLIC_LOGIN_SOCIAL_PROOF_VISIBLE=false

# Presentation-only switch for the active-candidate message on the dashboard.
NEXT_PUBLIC_DASHBOARD_SOCIAL_PROOF_VISIBLE=false

# Optional official voting destination used by the landing-page vote CTA.
# When omitted, the page shows an honest "not connected yet" dialog.
NEXT_PUBLIC_STARTUPTHON_VOTE_URL=
