# ══════════════════════════════════════════════════
# PrepVista — Environment Variables
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════

# ── App ──────────────────────────────────────────
APP_NAME="PrepVista"
PREPVISTA_DEBUG=true
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Use explicit comma-separated values in production; wildcards are rejected.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_HEADERS_ENABLED=true
MAX_REQUEST_SIZE_MB=10

# ── Admin ────────────────────────────────────────
ADMIN_EMAIL=your_admin_email@example.com

# ── Supabase ─────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
DATABASE_URL=postgresql://postgres:your_password@db.YOUR_PROJECT.supabase.co:5432/postgres
# Unified rollout: apply reviewed schema separately before starting the app.
# The code default remains true for compatibility with existing installations.
DATABASE_MIGRATIONS_ON_STARTUP=false
ARTIFACT_REVIEW_ENABLED=false
ARTIFACT_REVIEWER_PROFILE_IDS=

# ── Razorpay ─────────────────────────────────────
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── LLM Providers ────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EVAL_MODEL=llama-3.3-70b-versatile

# OpenAI (fallback)
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ── Upstash Redis (Rate Limiting) ────────────────
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token

# ── Server-side STT (Fix 1) ──────────────────────
# Master gate for the MediaRecorder -> WebSocket -> Groq Whisper pipeline.
# Default OFF; flip to true after browser QA to roll out to colleges.
STT_SERVER_ENABLED=false
GROQ_WHISPER_MODEL=whisper-large-v3
# Optional Deepgram Nova-2 fallback. Leave blank to run Groq-only.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# Private Supabase Storage bucket for retained interview audio (create it first).
INTERVIEW_AUDIO_BUCKET=interview-audio
AUDIO_RETENTION_DAYS=90
OFFER_DOCUMENT_BUCKET=offer-documents
OFFER_DOCUMENT_MAX_MB=8
# The frontend reads the SAME flag via NEXT_PUBLIC_STT_SERVER_ENABLED (set it in
# the frontend env), and NEXT_PUBLIC_API_URL must point at this backend.

# ── Resend (Email) ───────────────────────────────
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=PrepVista <noreply@prepvista.ai>

# ── SMTP (Manual Signup Verification) ────────────
# Gmail API (Manual Signup Verification)
# Uses HTTPS instead of SMTP for signup OTP and admin notification emails.
GMAIL_API_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_API_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_API_REFRESH_TOKEN=your_google_refresh_token
GMAIL_API_FROM_EMAIL=PrepVista <your_email@gmail.com>

# ── Sentry (Monitoring) ─────────────────────────
# SENTRY_DSN=https://your_sentry_dsn
# Applies to newly created sessions only; stored V2 sessions remain V2.
INTERVIEW_ORCHESTRATOR_V2=true

# Set both workspace and all-students flags true for normal signed-in access.
# With all-students false, only exact pilot profile IDs have access.
# These switches do not enable sync, AI or readiness.
CODING_WORKSPACE_ENABLED=false
CODING_ALL_STUDENTS_ENABLED=false
CODING_PILOT_PROFILE_IDS=
CODING_SERVER_SYNC_ENABLED=false
CODING_GUEST_IMPORT_ENABLED=false
CODING_AI_ENABLED=false
CODING_AI_PROVIDER=groq
CODING_AI_MODEL=llama-3.1-8b-instant
CODING_AI_DAILY_LIMIT=10
CODING_AI_GLOBAL_DAILY_LIMIT=1000
CODING_AI_GLOBAL_CONCURRENCY=10
UNIFIED_READINESS_VISIBLE=false
UNIFIED_EVIDENCE_ENABLED=false
# Evidence shares the existing backend/pool; no separate worker service needed.
UNIFIED_EVIDENCE_IN_PROCESS_ENABLED=true
UNIFIED_TPO_VISIBLE=false
UNIFIED_ASSIGNMENTS_ENABLED=false
# Requires a qualified dedicated Linux runner host, immutable image and HTTPS ingress.
# Leave disabled until the container isolation and full release checks have passed.
CODING_TRUSTED_VALIDATION_ENABLED=false
CODING_RUNNER_URL=
CODING_RUNNER_TOKEN=
CODING_RUNNER_IMAGE=
CODING_RUNNER_QUALIFICATION_ID=
CODING_VALIDATION_DAILY_LIMIT=5
CODING_VALIDATION_GLOBAL_DAILY_LIMIT=100
CODING_VALIDATION_GLOBAL_CONCURRENCY=2
# Optional provider adapter; never expose this key to the frontend.
GEMINI_API_KEY=

# Apply migration 044 before deploying this worker. Uses existing DATABASE_URL and Groq.
INTERVIEW_EVALUATION_WORKER_ENABLED=true
