# Copy this file to `.env` for local development. Never commit the real `.env`.
#
# Every variable below is read through the centralized settings system in
# backend/app/core/config.py -- see docs/configuration.md for the full
# reference (required vs optional, validation rules, which section each
# variable belongs to).

# --- Application -------------------------------------------------------
APP_NAME="Autonomous Engineer"
APP_VERSION=0.1.0
APP_ENV=development           # development | testing | staging | production
DEBUG=true                    # must be false when APP_ENV=production

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# --- CORS (comma-separated list of allowed origins, empty = disabled) ------
CORS_ORIGINS=

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console             # console | json (use json in staging/production)

# --- Database ------------------------------------------------------------
# DATABASE_URL, if set, takes precedence over the POSTGRES_* fields below
# (useful for managed Postgres providers that hand you a single connection
# string). Leave it empty to assemble the URL from POSTGRES_* instead.
DATABASE_URL=
POSTGRES_USER=autoeng
POSTGRES_PASSWORD=change-me-in-real-environments
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autoeng_db

# --- Worker (placeholder — no worker runtime exists yet) --------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
TASK_TIMEOUT_SECONDS=300
MAX_TASK_RETRIES=3

# --- AI / model layer -----------------------------------------------------
# Provider adapters (Gemini, Groq, Cerebras, OpenRouter) are implemented as
# of Part 4 -- see docs/ai-providers.md. AI_ENABLED/DEFAULT_PROVIDER/
# DEFAULT_MODEL are still unused by application code (no model router or
# agent exists yet); they're read here so that layer won't need new config
# plumbing when it's built.
AI_ENABLED=false
DEFAULT_PROVIDER=
DEFAULT_MODEL=
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3
AI_MAX_OUTPUT_TOKENS=4096

# Provider credentials. Leave empty locally to use MockModelProvider only;
# set only in a real secrets manager / deployment environment. Never commit
# real values here.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- Security (placeholder — no authentication exists yet) -----------------
# SECRET_KEY is required when APP_ENV=production; leave empty in development.
SECRET_KEY=
ALLOWED_HOSTS=
SESSION_TIMEOUT=3600

# --- Sandbox (placeholder — no execution sandbox exists yet) ---------------
SANDBOX_ENABLED=false
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_NETWORK_ENABLED=false

# --- Git (placeholder — no Git automation exists yet) -----------------------
GIT_ENABLED=false
GIT_AUTHOR_NAME="Autonomous Engineer Bot"
GIT_AUTHOR_EMAIL=bot@autonomous-engineer.local

# --- Browser (placeholder — no browser automation exists yet) --------------
BROWSER_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=30

# --- Observability (placeholder — no metrics/tracing stack exists yet) -----
METRICS_ENABLED=false
TRACING_ENABLED=false
