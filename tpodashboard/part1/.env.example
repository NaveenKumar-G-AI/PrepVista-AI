# Copy this file to .env and fill in real values for your environment.
# Never commit an actual .env file.

# --- App ---
APP_NAME=PrepVista API
ENVIRONMENT=development
# development | test | production
DEBUG=true

# --- Database ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://prepvista:CHANGE_ME@localhost:5432/prepvista_dev

# --- Auth / JWT ---
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# There is no safe default for this in production — the app ships with an
# obviously-fake dev default that you must override.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# JSON array of allowed origins for your frontend.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Storage ---
# local | s3 (s3 is not implemented in Part 1 — interface only, see
# app/services/storage_service.py)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/documents

# --- Login rate limiting ---
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Import ---
IMPORT_MAX_ROWS=20000
