    "get_target_gap",
    "get_opportunity_coverage",
    "get_skill_demand",
    "get_skill_supply",
    "get_company_concentration",
    "get_industry_concentration",
    "get_strategic_gaps",
    "run_scenario",
    "get_strategic_recommendations",
