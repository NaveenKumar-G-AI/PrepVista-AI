{
  "module": "placement-strategy-intelligence",
  "version": "1.0.0",
  "description": "PrepVista AI Part 15 — Placement Forecasting + Strategy Engine + Institutional Intelligence",
  "routes": [],
  "api": [
    "GET /api/forecast/placement",
    "GET /api/forecast/offers",
    "GET /api/forecast/departments/:departmentId",
    "GET /api/forecast/accuracy",
    "GET /api/strategy/target-gap",
    "GET /api/strategy/gap-explanation",
    "GET /api/strategy/gaps",
    "GET /api/strategy/recommendations",
    "POST /api/strategy/recommendations/:id/accept",
    "GET /api/strategy/roadmap",
    "GET /api/strategy/opportunity-coverage",
    "GET /api/strategy/skills",
    "GET /api/strategy/company-concentration",
    "GET /api/strategy/industry-concentration",
    "GET /api/strategy/outreach-priorities",
    "POST /api/strategy/scenarios/run",
    "POST /api/strategy/scenarios/compare",
    "GET /api/strategy/students/:studentId/personal-outlook"
  ],
  "database_tables": [
    "placement_target",
    "forecast_record",
    "forecast_performance",
    "scenario_run",
    "strategic_gap",
    "strategic_recommendation",
    "strategic_action",
    "company_outreach_priority",
    "strategy_audit_log"
  ],
