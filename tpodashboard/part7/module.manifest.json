{
  "module": "training-readiness",
  "version": "0.1.0",
  "description": "PrepVista Part 7 — Training + Assessment + Intervention + Readiness Improvement Engine",
  "status": "reference-implementation — see docs/TRUTH_TABLE.md before treating anything as production-ready",
  "routes": [
    "POST /api/tpo/training/programs",
    "POST /api/tpo/training/programs/:id/transition",
    "GET  /api/tpo/training/programs/:id",
    "POST /api/tpo/training/programs/:id/sessions",
    "POST /api/tpo/training/cohorts",
    "POST /api/tpo/preview-selection",
    "POST /api/tpo/training/programs/:id/enroll",
    "POST /api/tpo/training/attendance",
    "POST /api/tpo/assessments",
    "POST /api/tpo/assessments/:id/versions",
    "POST /api/tpo/assessments/versions/:versionId/publish",
    "POST /api/tpo/assessments/attempts/:attemptId/finalize",
    "POST /api/tpo/interventions",
    "POST /api/tpo/interventions/:id/assign-one",
    "POST /api/tpo/interventions/:id/assign",
    "POST /api/tpo/interventions/assignments/:id/transition",
    "POST /api/tpo/interventions/detect-overdue",
    "GET  /api/tpo/interventions/workbench",
    "GET  /api/tpo/interventions/:id/effectiveness",
    "GET  /api/tpo/analytics/overview",
    "GET  /api/tpo/analytics/students-needing-intervention",
    "GET  /api/tpo/analytics/department-readiness",
    "GET  /api/tpo/analytics/training/:id/effectiveness",
    "GET  /api/tpo/analytics/insights",
    "GET  /api/student/readiness",
    "GET  /api/student/skill-gaps",
    "GET  /api/student/training",
    "GET  /api/student/assessments",
    "GET  /api/student/interventions",
    "GET  /api/student/action-plan",
    "POST /api/student/assessments/:versionId/start",
    "POST /api/student/assessments/attempts/:attemptId/submit",
    "GET  /api/management/overview",
    "GET  /api/management/department-readiness",
    "GET  /api/management/training/:id/effectiveness",
    "GET  /api/management/interventions/:id/effectiveness"
  ],
  "database_tables": [
    "taxonomy_term",
    "training_program",
    "training_cohort",
    "training_cohort_member",
    "training_session",
    "training_enrollment",
    "training_attendance",
    "assessment",
    "assessment_version",
    "assessment_question",
    "assessment_attempt",
    "assessment_result",
    "skill_measurement",
    "readiness_snapshot",
    "intervention",
    "intervention_assignment",
    "student_success_event",
    "audit_log"
  ],
  "integration_stub_tables_not_owned": [
    "institution", "season", "user_account", "student", "skill",
    "application", "interview_result", "offer"
  ],
  "events_published": [
    "TRAINING_PROGRAM_CREATED", "TRAINING_PROGRAM_STARTED", "TRAINING_PROGRAM_COMPLETED",
    "TRAINING_ENROLLMENT_CREATED", "TRAINING_COMPLETED",
    "TRAINING_SESSION_CREATED", "TRAINING_ATTENDANCE_RECORDED",
    "ASSESSMENT_STARTED", "ASSESSMENT_COMPLETED", "ASSESSMENT_RESULT_RECORDED",
    "INTERVENTION_CREATED", "INTERVENTION_ASSIGNED", "INTERVENTION_STARTED",
    "INTERVENTION_COMPLETED", "INTERVENTION_OVERDUE",
    "READINESS_UPDATED", "READINESS_DECLINED", "READINESS_IMPROVED",
    "TRAINING_EFFECTIVENESS_UPDATED"
  ],
  "events_declared_but_not_yet_published": ["ASSESSMENT_ASSIGNED"],
  "events_consumed": [],
  "note_on_events_consumed": "ASSESSMENT_ASSIGNED is defined in the contract (spec §63) but never published by this implementation — nothing in Part 7 currently models the moment an assessment is assigned to a student ahead of them starting it, only start/complete. Flagging rather than fabricating a publish call for an event that doesn't have a real trigger yet. Verified by cross-referencing every declared event type against every eventBus.publish() call site — this is the only gap.",
  "services_exposed": [
    "services/readinessService.ts",
    "services/skillGapService.ts",
    "services/recommendationService.ts",
    "services/assessmentService.ts",
    "services/trainingService.ts",
    "services/interventionService.ts",
    "services/effectivenessService.ts",
    "services/overviewService.ts",
    "services/actionPlanService.ts",
    "ai-tools/index.ts"
  ],
  "dependencies": [
    "institution",
    "season",
    "students",
    "skills",
    "applications",
    "interviews",
    "offers"
  ],
  "owned_paths": [
    "src/db/schema/taxonomy.ts",
    "src/db/schema/training.ts",
    "src/db/schema/assessment.ts",
    "src/db/schema/skills.ts",
    "src/db/schema/readiness.ts",
    "src/db/schema/intervention.ts",
    "src/db/schema/audit.ts",
    "src/services/**",
    "src/ai-tools/**",
    "src/api/**",
    "src/lib/**",
    "src/config/**",
    "drizzle/**",
    "tests/**"
  ],
  "not_owned_do_not_modify": [
    "src/db/schema/stubs.ts (delete on integration — see docs/INTEGRATION_NOTES.md)"
  ]
}
