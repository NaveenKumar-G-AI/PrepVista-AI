{
  "name": "prepvista-part11",
  "version": "1.0.0",
  "description": "PrepVista AI — Part 11: Administration, Security, Governance, RBAC, Audit & Data Quality Control Center",
  "main": "dist/src/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/src/server.js",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "pretest": "rm -f db/test.db db/test.db-wal db/test.db-shm && cross-env DATABASE_URL=file:./db/test.db tsx db/migrate.ts",
    "test": "cross-env DATABASE_URL=file:./db/test.db node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
