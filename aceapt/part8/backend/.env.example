# ============================================================
# ACEAPT FEATURE 8 - environment configuration
# Copy this file to .env and fill in the blanks below.
# Nothing in this repo will run against real AI generation
# until ANTHROPIC_API_KEY is filled in - the deterministic
# core (scoring, state machine, review scheduling, etc) works
# without it, using the seeded question pool.
# ============================================================

# --- Server ---
PORT=4008
NODE_ENV=development

# --- Postgres ---
# Local dev defaults match scripts/setup-local-db.sh.
# DATABASE_URL: RLS-bound app pool, used per HTTP request (SET LOCAL app.current_student_id).
# SERVICE_DATABASE_URL: owns the schema, BYPASSRLS. Used for migrations, seeding, and
#   cross-student background jobs (review sweep, regression sweep). Keep this out of
#   anything request-facing.
DATABASE_URL=postgresql://aceapt_app:CHANGE_ME@localhost:5432/aceapt_dev
SERVICE_DATABASE_URL=postgresql://aceapt_service:CHANGE_ME@localhost:5432/aceapt_dev

# --- Auth ---
# Generate a real secret before any non-local use, e.g.: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI provider (question variation / transfer generation / mastery summaries) ---
# Leave blank until you have a key. See src/services/ai/anthropicProvider.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Feature 3/4/6/7 integration ---
# Blank = signals are logged + stored in the signal_outbox table only (safe default).
# Fill these in once the real services exist, see src/services/integration/featureAdapters.ts
FEATURE7_WEBHOOK_URL=
FEATURE4_WEBHOOK_URL=
FEATURE3_WEBHOOK_URL=
FEATURE6_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=

# --- Feature 5/6 -> Feature 8 evidence ingestion ---
# Server-to-server shared secret for POST /mastery/ingest/evidence.
# Generate with: openssl rand -hex 24
INTERNAL_INGEST_KEY=
