# Only needed in production (or if you don't want to use the dev proxy).
# Point this at wherever the backend is actually reachable, e.g.:
#   VITE_API_BASE_URL=https://api.yourdomain.com
# In local dev, leave this unset - vite.config.ts already proxies /api to
# the backend on localhost:4008 (see VITE_API_PROXY_TARGET below if the
# backend runs on a different port).
VITE_API_BASE_URL=

# Dev-only: where the Vite dev server's /api proxy forwards to.
VITE_API_PROXY_TARGET=http://localhost:4008
