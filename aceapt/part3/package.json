{
  "name": "aceapt-feature3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "tsx src/seed.ts",
    "dev": "npm run build:web && tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build:web": "esbuild web/src/main.tsx --bundle --outfile=web/dist/bundle.js --jsx=automatic --loader:.css=css --define:process.env.NODE_ENV='\"production\"' && cp web/index.html web/dist/index.html",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "esbuild": "^0.23.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  }
}
