# Copy this file to .env and fill in real values. Nothing here is a working credential.

# --- Database -----------------------------------------------------------
# App connection: the unprivileged, RLS-scoped `aceapt_app` role that
# db/migrate.ts creates. `dev_only_local_password` is not a secret — it is
# set locally by the migration script for this throwaway dev DB. Replace the
# whole URL when pointing at a real environment.
DATABASE_URL=postgres://aceapt_app:dev_only_local_password@localhost:5432/aceapt_feature13

# Migration connection: needs privileges to CREATE ROLE / GRANT, so it runs
# as the Postgres superuser. Only db/migrate.ts uses this — the running app
# never does. Real deployments typically run this once from CI, not from the
# app's own credentials.
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aceapt_feature13

# Background-job connection that sets app.is_service_role=true to read across
# students (e.g. cohort rollups, Section 54). Leave blank to disable —
# per-request RLS still works without it.
DATABASE_SERVICE_URL=

# --- Auth -----------------------------------------------------------------
# Feature 13 does not implement its own auth. It expects an upstream
# middleware (your existing PrepVista/ACEAPT auth) to populate
# req.auth = { studentId, institutionId, role }. See
# src/api/middleware/auth.ts for the seam and its dev-only fallback.
AUTH_JWT_PUBLIC_KEY=

# --- AI explanation layer --------------------------------------------------
# Optional. If blank, the explanation engine falls back to the deterministic
# template narrator (src/ai/templateExplainer.ts) and the product works
# end-to-end with zero AI cost. Add a key to upgrade explanations to
# Claude-polished prose (src/ai/anthropicExplainer.ts). The LLM is never
# allowed to invent numbers — see src/ai/explanationService.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server -----------------------------------------------------------
PORT=4013
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
