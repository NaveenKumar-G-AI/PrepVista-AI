# ACEAPT Feature 9 - Real-World Performance Simulation Engine
# Copy this file to .env and fill in real values before deploying.
# Everything below is intentionally left blank as requested.

# Port the API server listens on.
PORT=4000

# Secret used to sign/verify student auth JWTs.
# Replace with your real ACEAPT auth secret, or better: delete
# src/middleware/auth.ts entirely and mount this router behind your
# existing ACEAPT authentication middleware (see INTEGRATION.md).
JWT_SECRET=

# Optional. Only needed if you wire up natural-language report narration
# or the AI-assisted question generation pipeline described in the spec
# (sections 44/45). The engine runs fully without this - scoring, timing,
# and analytics are deterministic and never call an AI provider.
AI_API_KEY=

# Optional. Only needed once InMemorySimulationRepository (see
# src/repositories/simulationRepository.ts) is swapped for a real
# database-backed implementation of the same interface.
DATABASE_URL=

# Set to "production" to disable the /api/dev/token convenience route.
NODE_ENV=development
