# ACEAPT — Feature 2: Adaptive Aptitude Diagnostic Engine
# Copy this file to .env and fill in values. Nothing here is required to run
# the app — every key below is optional and the system degrades gracefully
# (see lib/ai/groqClient.ts) when it is missing.

# Groq API key, used only to turn the already-computed diagnostic evidence
# into a warm natural-language narrative. Leave blank to run in pure
# deterministic mode (a template-based narrative is used instead, and the
# student never sees an error).
GROQ_API_KEY=

# Model id to call on Groq. llama-3.3-70b-versatile was deprecated by Groq
# in June 2026 — openai/gpt-oss-20b is the current fast/cheap default as of
# this writing. Check https://console.groq.com/docs/models for the current
# list before relying on this in production.
GROQ_MODEL=openai/gpt-oss-20b

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/aceapt.db
