// REFERENCE ONLY - not wired up or executed anywhere in this codebase.
//
// The running backend persists through the repository interfaces in
// src/repositories/*.ts, backed by a zero-dependency JSON-file store
// (src/repositories/jsonCollectionStore.ts) so this module boots with no
// external database and no native-module install risk.
//
// This file documents the intended shape once you point Feature 47 at
// ACEAPT's real Postgres (or whatever RDBMS ACEAPT already runs). To make
// the switch: implement each of the five repository interfaces
// (GuidedSessionRepository, GuidedStepStateRepository,
// GuidedAttemptRepository, GuidedAssistanceRepository,
// GuidedOutcomeRepository) against this schema (via Prisma or otherwise),
// then swap the `File*Repository` classes for your new ones in
// src/services/guidedSolvingService.ts's composition root. Nothing else in
// the codebase needs to change - the service layer only depends on the
// repository interfaces.
//
// Deliberately absent: Student, Question, Skill, Hint, Mistake, Mastery
// models. `studentId` / `problemId` are plain foreign references into
// ACEAPT's existing systems (Section 7: reuse, do not duplicate).
//
// Enums are intentionally modeled as `String` here (not Prisma `enum`) so
// this reference schema is portable across Postgres/MySQL/SQLite without
// per-provider enum quirks; swap to native enums if your target DB and
// Prisma version support them and you want stricter DB-level constraints.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GuidedSession {
  id                    String    @id @default(uuid())
  studentId             String
  problemId             String
  variantId             String?
  status                String // STARTED | ACTIVE | PAUSED | COMPLETED | ABANDONED | TIMED_OUT
  mode                  String // GUIDED | VERIFICATION
  currentStepIndex      Int       @default(0)
  version               Int       @default(0)
  firstErrorStepId      String?
  solutionRevealed      Boolean   @default(false)
  solutionRequested     Boolean   @default(false)
  reconstructionSuccess Boolean?
  parentSessionId       String?
  startedAt             DateTime  @default(now())
  lastActivityAt        DateTime  @default(now())
  completedAt           DateTime?

  steps      GuidedStepState[]
  assistance GuidedAssistance[]
  outcome    GuidedOutcome?

  @@index([studentId])
  @@index([parentSessionId])
}

model GuidedStepState {
  id                    String    @id @default(uuid())
  sessionId             String
  session               GuidedSession @relation(fields: [sessionId], references: [id])
  stepId                String
  sequence              Int
  status                String // PENDING | CORRECT | PARTIALLY_CORRECT | INCORRECT | FORMAT_ERROR | UNIT_ERROR | INCOMPLETE | UNKNOWN | SKIPPED
  helpLevel             Int       @default(0)
  consecutiveFailures   Int       @default(0)
  skipped               Boolean   @default(false)
  independent           Boolean   @default(true)
  recoveredWithGuidance Boolean   @default(false)
  startedAt             DateTime  @default(now())
  completedAt           DateTime?

  attempts GuidedAttempt[]

  @@unique([sessionId, stepId])
}

model GuidedAttempt {
  id              String   @id @default(uuid())
  sessionId       String
  stepStateId     String
  stepState       GuidedStepState @relation(fields: [stepStateId], references: [id])
  stepId          String
  attemptNumber   Int
  rawInput        String
  result          String
  numericValue    Float?
  structuredValues Json?
  detail          String?
  elapsedMs       Int?
  clientRequestId String?
  createdAt       DateTime @default(now())

  @@index([stepStateId])
}

model GuidedAssistance {
  id                  String   @id @default(uuid())
  sessionId           String
  session             GuidedSession @relation(fields: [sessionId], references: [id])
  stepId              String?
  type                String // HINT | EXPLANATION | NEXT_STEP | FULL_SOLUTION | AUTO_ESCALATION
  helpLevel           Int
  assistanceIssueType String?
  source              String // AI | DETERMINISTIC_FALLBACK | TEMPLATE
  message             String
  createdAt           DateTime @default(now())

  @@index([sessionId])
}

model GuidedOutcome {
  id                    String   @id @default(uuid())
  sessionId             String   @unique
  session               GuidedSession @relation(fields: [sessionId], references: [id])
  studentId             String
  problemId             String
  stepsTotal            Int
  stepsIndependent      Int
  stepsAssisted         Int
  hintsUsed             Int
  retries               Int
  firstErrorStepId      String?
  recoverySuccess       Boolean  @default(false)
  solutionRequested     Boolean  @default(false)
  reconstructionSuccess Boolean?
  verificationSessionId String?
  verificationSuccess   Boolean?
  transferSuccess       Boolean?
  guidanceDependency    String // LOW | MODERATE | HIGH
  studentFeedback       String?
  createdAt             DateTime @default(now())

  @@index([studentId])
}
