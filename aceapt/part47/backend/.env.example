# ACEAPT Feature 47 - Guided Solving Engine
# Copy this file to `.env` and fill in the blanks. Nothing with a real
# external credential ships with a value - you fill those in.

# ---------------------------------------------------------------------------
# AI (optional). Leave blank to run entirely on deterministic fallback logic
# (Section 66 / AI Fallback). Hints and explanations will use the canned
# hint ladders and templates authored in the problem bank instead of the
# model. Fill this in whenever you're ready to enable AI-generated,
# language-adapted hints and explanations.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Small/fast model recommended for short hint/explanation generation.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Hard timeout for a single AI call before falling back (ms).
ANTHROPIC_TIMEOUT_MS=4000

# ---------------------------------------------------------------------------
# Auth (DEV STUB ONLY - see src/api/middleware/auth.ts).
# ACEAPT already has real authentication; this stub exists purely so this
# module is runnable and testable standalone. Replace requireAuth() with a
# call into ACEAPT's real session/JWT verification when integrating, and
# delete the /api/dev/token route entirely.
#
# This is NOT one of "your keys" in the production sense, but treat it as a
# secret in any shared environment: it signs the stub tokens below.
# ---------------------------------------------------------------------------
AUTH_STUB_SECRET=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Persistence
# See docs/schema-reference.prisma and README "Persistence" section.
# Default is a zero-dependency JSON-file store under DATA_DIR so this runs
# out of the box. Point DATA_DIR at a persistent volume in production, or
# swap the repository implementations in src/repositories for real
# Postgres/whatever-ACEAPT-already-uses ones - the service layer only talks
# to the repository interfaces, never to storage directly.
# ---------------------------------------------------------------------------
DATA_DIR=./.data
