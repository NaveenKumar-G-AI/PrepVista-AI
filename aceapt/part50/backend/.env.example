# Copy to .env and fill in. Every secret below is intentionally left blank.

# ---- Server ----
PORT=4050
NODE_ENV=development

# ---- Database ----
# Leave blank to run the service with in-memory storage (no persistence,
# useful for local dev / demo). Point it at Postgres when ready:
# postgresql://user:password@host:5432/aceapt
DATABASE_URL=

# ---- Auth ----
# Must match the secret/public key used by the existing ACEAPT auth token
# issuer, since Feature 50 only verifies tokens, it does not issue them.
JWT_SECRET=

# ---- AI coaching (optional) ----
# AI is only ever used to rephrase already-decided coaching copy (see
# src/services/aiCoachingService.ts). Leave ANTHROPIC_API_KEY blank to run
# on deterministic coaching text only - nothing breaks without it.
ANTHROPIC_API_KEY=
AI_COACHING_MODEL=claude-haiku-4-5-20251001
ENABLE_AI_COACHING=false
