# Feature 58 — Guessing Intelligence Engine
# Copy this file to .env and fill in real values. Every value below is
# intentionally left blank; the app boots fine with all of them empty and
# only fails (loudly, at the point of use) once something that actually
# needs a value is called.

# --- Server ---------------------------------------------------------------
PORT=

# --- Database (PostgreSQL) -------------------------------------------------
# e.g. postgres://user:password@localhost:5432/aceapt
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Placeholder for ACEAPT's existing JWT/session verification. Leave blank
# during local development; middleware/auth.ts explains what to replace.
JWT_PUBLIC_KEY=

# --- AI Gateway (optional) --------------------------------------------------
# Leave blank to run entirely on the template-based fallback (no AI calls at
# all — see adapters/defaultPorts.ts, §192 "AI FALLBACK"). Set both to enable
# AI-phrased decision explanations and pattern summaries.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# --- Multi-tenancy (local/dev only) -----------------------------------------
DEFAULT_TENANT_ID=
