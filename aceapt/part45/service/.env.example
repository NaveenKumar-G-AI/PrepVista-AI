# ============================================================================
# ACEAPT Feature 45 — Aptitude Skill Graph — environment configuration
# Copy to .env and fill in. Nothing in here ships with real values.
# ============================================================================

# --- Database -----------------------------------------------------------
# Dev/test default: file-based SQLite, zero external setup required.
# For production, point this at your real Postgres instance and switch
# `provider` in prisma/schema.prisma from "sqlite" to "postgresql"
# (see service/README section "Moving to Postgres").
DATABASE_URL="file:./dev.db"

# --- Server ---------------------------------------------------------------
PORT=4045
NODE_ENV=development

# --- Auth -------------------------------------------------------------------
# THIS SERVICE DOES NOT SHIP A REAL AUTH SYSTEM.
# src/api/middleware/auth.middleware.ts contains a clearly-marked stub that
# reads "Authorization: Bearer <userId>:<role>[:<institutionId>]" so the
# ownership/role checks are testable end to end today. Replace it with
# ACEAPT's real JWT/session verification before deploying. Leave this
# secret blank until you wire in the real thing.
AUTH_JWT_SECRET=

# --- AI suggestion adapter (optional — everything else works without it) --
# Feature 45 never lets AI write to the published graph directly (spec
# section 19). If ANTHROPIC_API_KEY is blank, AI-suggestion endpoints
# return "unavailable" and every other endpoint is unaffected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Integration adapter mode ----------------------------------------------
# "stub" = built-in reference adapters, no external systems required (default)
# "live" = you have wired real implementations into src/integrations/*
MASTERY_ADAPTER_MODE=stub
MISTAKE_ADAPTER_MODE=stub
RETENTION_ADAPTER_MODE=stub
GOAL_ADAPTER_MODE=stub
ROSTER_ADAPTER_MODE=stub
