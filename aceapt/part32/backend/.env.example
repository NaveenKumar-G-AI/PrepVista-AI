# Copy this file to .env and fill in real values before deploying.
# Nothing below is a real secret — every value is intentionally left blank.

# --- Server ---
PORT=4000
ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Auth integration (see src/middleware/common.ts) ---
# This build ships a development-only stub that trusts an `x-student-id`
# header. Point these at ACEAPT's real session/auth service when wiring
# this feature into the real product, then remove the stub.
AUTH_SERVICE_URL=
AUTH_SERVICE_API_KEY=

# --- Persistence ---
# Demo persistence is a local JSON file (see src/data/repository.ts).
# Set DATABASE_URL and swap the repository implementation for production.
DATABASE_URL=

# --- Optional: LLM-generated explanations (off by default) ---
# Deterministic, evidence-grounded explanations are used unless this is
# enabled AND a key is present (see src/services/explanation.service.ts).
USE_LLM_EXPLANATIONS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
