// ACEAPT - Feature 56: Formula Intelligence Engine
//
// Design-time schema. NOT generated/run in this scaffold: there is no live
// database or Prisma engine-binary access in this environment, so
// `npx prisma generate` was not executed here. Treat this file as the
// source of truth for the shape of the tables described in spec section
// 159-163, and adapt it to whatever ORM/migration tool ACEAPT already uses
// if that isn't Prisma. The engine itself never imports @prisma/client
// directly - it only depends on the repository interfaces in
// src/repositories/index.ts, so wiring a real database in means
// implementing those interfaces, not touching engine code.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FormulaStatus {
  DRAFT
  VALIDATING
  APPROVED
  PUBLISHED
  SUSPENDED
  DEPRECATED
  RETIRED
}

enum RelationshipType {
  RELATED_TO
  DERIVED_FROM
  INVERSE_OF
  SPECIAL_CASE_OF
  OFTEN_CONFUSED_WITH
  REQUIRES
  USED_WITH
}

enum TrainingActivityType {
  RECOGNIZE
  RECALL
  SELECT
  MAP
  APPLY
  VERIFY
  TRANSFER
  RETAIN
}

enum FormulaErrorType {
  FORMULA_RECALL_ERROR
  FORMULA_SELECTION_ERROR
  VARIABLE_MAPPING_ERROR
  FORMULA_CONDITION_ERROR
  FORMULA_REARRANGEMENT_ERROR
  FORMULA_APPLICATION_ERROR
  FORMULA_VERIFICATION_ERROR
  FORMULA_TRANSFER_ERROR
  FORMULA_RETENTION_ERROR
}

model Formula {
  formulaId           String   @id @default(cuid())
  canonicalName       String
  canonicalExpression String
  domain              String
  concept             String
  meaning             String   @db.Text
  variables           Json // FormulaVariable[]
  conditions          Json // FormulaConditions
  derivedForms        Json // DerivedForm[]
  skillId             String?
  subSkillId          String?
  status              FormulaStatus @default(DRAFT)
  version             Int           @default(1)
  source              String
  tenantId            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  relationshipsFrom FormulaRelationship[]     @relation("relationshipSource")
  relationshipsTo   FormulaRelationship[]     @relation("relationshipTarget")
  studentStates     FormulaStudentState[]
  attempts          FormulaTrainingAttempt[]
  questionMappings  FormulaQuestionMapping[]

  @@index([domain])
  @@index([status])
  @@index([tenantId])
}

model FormulaRelationship {
  id               String            @id @default(cuid())
  sourceFormulaId  String
  targetFormulaId  String
  relationshipType RelationshipType
  evidenceBacked   Boolean           @default(false)

  source Formula @relation("relationshipSource", fields: [sourceFormulaId], references: [formulaId])
  target Formula @relation("relationshipTarget", fields: [targetFormulaId], references: [formulaId])

  @@unique([sourceFormulaId, targetFormulaId, relationshipType])
  @@index([sourceFormulaId])
  @@index([targetFormulaId])
}

// One row per (student, formula). See FormulaStudentStateService for how the
// JSON `dimensions` blob is read/written as a whole. If your team prefers a
// fully normalized table (one row per dimension), split this out - the JSON
// shape here is optimized for "read/write the whole state at once", which
// is how the engine actually uses it.
model FormulaStudentState {
  id                String    @id @default(cuid())
  studentId         String
  formulaId         String
  dimensions        Json // Record<CompetencyDimension, DimensionEvidence>
  supportLevel      String
  independentStreak Int       @default(0)
  regressionFlag    Boolean   @default(false)
  lastEvidenceAt    DateTime?

  formula Formula @relation(fields: [formulaId], references: [formulaId])

  @@unique([studentId, formulaId])
  @@index([studentId])
}

model FormulaTrainingSession {
  sessionId      String   @id @default(cuid())
  studentId      String
  formulaId      String
  tenantId       String?
  assessmentMode Boolean  @default(false)
  startedAt      DateTime @default(now())

  attempts FormulaTrainingAttempt[]

  @@index([studentId])
}

model FormulaTrainingAttempt {
  id                      String                @id @default(cuid())
  sessionId               String
  studentId               String
  formulaId               String
  formulaVersionAtAttempt Int
  activityType            TrainingActivityType
  correct                 Boolean
  errorType               FormulaErrorType?
  distractorFormulaId     String?
  involvedConfusionPair   Boolean?
  responseTimeMs          Int?
  hintLevel               Int?
  difficulty              String?
  novelty                 String?
  createdAt               DateTime              @default(now())

  session FormulaTrainingSession @relation(fields: [sessionId], references: [sessionId])
  formula Formula                @relation(fields: [formulaId], references: [formulaId])

  @@index([studentId, formulaId])
  @@index([sessionId])
}

// Formula <-> validated question linkage (spec sections 113-114, 161).
// questionVersionId is intentionally just a String here - the actual
// Question entity lives in your Feature 53/54 tables, not this module's.
model FormulaQuestionMapping {
  id                String  @id @default(cuid())
  questionVersionId String
  formulaId         String
  role              String // PRIMARY | SECONDARY | CHAIN_STEP
  sequence          Int?
  confidence        String // EXPLICIT | VALIDATED | INFERRED | UNCERTAIN

  formula Formula @relation(fields: [formulaId], references: [formulaId])

  @@index([questionVersionId])
  @@index([formulaId])
}
