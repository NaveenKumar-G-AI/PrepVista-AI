# ACEAPT Feature 56 - Formula Intelligence Engine
# All secrets are intentionally left blank below - fill these in for your
# own environment. Do not commit a real .env file.

# Postgres connection string matching prisma/schema.prisma
DATABASE_URL=

# AI gateway - only used by the optional AIGatewayPort explanations.
# The engine is fully functional without this (see src/integrations/ports.ts
# and the "AI unavailable" test in tests/trainingEngine.test.ts).
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# The attachAuthContext middleware in src/api/middleware.ts is a DEV-ONLY
# header-based stub, not real authentication. Once you replace it with real
# session/JWT verification, this becomes that system's signing secret (or
# delete this line if your auth provider handles signing itself).
JWT_SECRET=

PORT=4056
NODE_ENV=development
