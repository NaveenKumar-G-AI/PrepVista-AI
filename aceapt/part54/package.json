{
  "name": "@aceapt/feature-54-question-validation-engine",
  "version": "1.0.0",
  "description": "ACEAPT Feature 54 — Question Validation Engine: objective, versioned, dependency-aware validation of question versions prior to publication/delivery.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --pool=forks --poolOptions.forks.singleFork=true",
    "test:security": "vitest run test/security --pool=forks --poolOptions.forks.singleFork=true",
    "test:react": "vitest run test/react",
    "test:all": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "tsx watch src/api/server.ts"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "mathjs": "^13.2.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
