# ACEAPT Feature 54 — Question Validation Engine
# Copy to .env and fill in values. Every secret below is intentionally blank.

# --- Database -----------------------------------------------------------
# Superuser/migration connection (runs db/migrations/*.sql). Never used by
# the running application — only by scripts/migrate.ts.
MIGRATION_DATABASE_URL=postgresql://postgres:@localhost:5432/aceapt_qve

# The application's OWN connection — must be the qve_app role, which has
# zero raw table grants (see db/migrations/003_qve_roles_rls.sql). Set the
# password to whatever you choose when creating the qve_app role; the
# migration creates it with a placeholder password you should change.
QVE_APP_DATABASE_URL=postgresql://qve_app:@localhost:5432/aceapt_qve

# --- AI-assisted semantic validation (spec §103-107) --------------------
# Optional. AISemanticValidator degrades to a labeled AI_UNAVAILABLE warning
# (never a false PASS) if this is unset — see src/ai/GroqAdapter.ts.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Server ---------------------------------------------------------------
PORT=3054
