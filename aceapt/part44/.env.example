# --- Server ---
PORT=4044
NODE_ENV=development

# --- Database ---
# The app connects as the non-superuser "goal_app" role so PostgreSQL Row
# Level Security is actually enforced (see db/migrations). Never point this
# at a superuser/owner role in production - RLS is bypassed for those.
DATABASE_URL=postgres://goal_app:CHANGE_ME@localhost:5432/aceapt_goals

# Used only by `npm run migrate` / `npm run seed`. Must be a role that
# owns (or can create) the tables - a superuser in dev, a dedicated
# migration role with no runtime traffic in production. Deliberately a
# different credential than DATABASE_URL: the runtime app should never be
# able to run DDL.
MIGRATION_DATABASE_URL=postgres://postgres@localhost:5432/aceapt_goals

# --- Auth ---
# Shared secret used to verify the JWT issued by ACEAPT's existing auth
# system (Feature: Authentication). This service does not issue tokens,
# only verifies them. Leave blank until wired to the real auth service.
JWT_PUBLIC_KEY_OR_SECRET=

# --- AI (Anthropic) ---
# Leave blank in this reference implementation. Fill in your own key when
# integrating - the goal engine works correctly with this blank because
# every AI-backed service has a deterministic fallback (see
# src/integrations/ai/*). Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_EXPLANATION_MODEL=claude-sonnet-5

# --- Integration points (stand-ins for Features 1-43) ---
# In the real ACEAPT codebase these are replaced by direct in-process
# calls (or internal HTTP calls) into the real services. See
# src/integrations/*  for the interfaces these must satisfy.
CAPABILITY_SERVICE_MODE=mock
LEARNING_SYSTEM_WEBHOOK_URL=
PLANNER_WEBHOOK_URL=
READINESS_WEBHOOK_URL=
