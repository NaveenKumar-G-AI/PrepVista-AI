# Copy this file to .env and fill in your own values.
# Nothing in this file is a working credential — replace every value before running.

# Postgres connection string for the Feature 20 database.
# Local dev example (matches the schema in src/db/schema.sql):
# DATABASE_URL=postgresql://aceapt:your_password@localhost:5432/aceapt_feature20
DATABASE_URL=

# Anthropic API key used ONLY for the AI-assisted layer (post-test narrative +
# coaching Q&A in src/ai/anthropicAdapter.ts). Scoring, timing, and analytics
# never depend on this key — see src/ai/README-INTEGRATION.md.
# If left blank, the AI adapter automatically falls back to the deterministic
# evidence-grounded templates in src/ai/fallbackNarratives.ts, so the API
# still runs and the test suite still passes without a key.
ANTHROPIC_API_KEY=

# Model string for the Anthropic adapter — update if your account uses a
# different alias.
ANTHROPIC_MODEL=claude-sonnet-5

PORT=4020

# Comma-separated list of origins allowed to call this API (your frontend dev
# server, your deployed frontend, etc).
CORS_ORIGINS=http://localhost:5173
