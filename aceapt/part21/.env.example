# ==========================================================
# ACEAPT OS — Feature 21 — environment configuration
# Copy this file to .env and fill in values yourself.
# Everything below is intentionally left blank.
# ==========================================================

# Optional. Only needed if you turn on LLM-enhanced explanation
# generation in src/explanationGenerator.ts (generateWithLLM()).
# Without this set, the engine uses the built-in template-based
# explanation generator and works fully offline.
ANTHROPIC_API_KEY=

# Optional. Model to use for LLM-enhanced explanations, if enabled.
ANTHROPIC_MODEL=

# Connection string for wherever you persist StudentModel /
# InterventionRecord data in production. Not used by the mock
# adapters (they run in-memory) — wire this into a real
# implementation of UpstreamEvidenceProvider when you replace
# MockUpstreamBundle in src/upstreamAdapters.ts.
DATABASE_URL=

# Base URL + key for the internal ACEAPT services that back
# Features 13–20, if those are exposed as HTTP APIs rather than
# in-process modules. Used only by your real adapter implementation.
ACEAPT_INTERNAL_API_BASE_URL=
ACEAPT_INTERNAL_API_KEY=
