# Copy this file to .env and fill in the blanks. Nothing below is required
# to run the demo (see fallbacks in src/config.ts) but you should set real
# values before this goes anywhere near production.

PORT=4000
NODE_ENV=development

# CORS origin for the frontend dev server.
CORS_ORIGIN=http://localhost:5173

# SQLite file. Swap the persistence layer (see repositories/) if your real
# ACEAPT backend already standardizes on Postgres/Mongo/etc.
DB_PATH=./data/aceapt.db

# --- Secrets: leave blank here, fill in your own .env ---

# Used to sign/verify student session JWTs. If left blank, a random
# ephemeral secret is generated at boot (dev-only, logs a warning, tokens
# will not survive a server restart). Set a real 32+ byte random value
# before deploying.
JWT_SECRET=

# Optional. Only required if you want the AI-assisted question generation
# path (src/generation/anthropicProvider.ts) to run. Without it, the
# generation pipeline automatically falls back to the deterministic
# TemplateProvider — the product still works end-to-end, it just won't
# synthesize brand-new AI-authored questions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
