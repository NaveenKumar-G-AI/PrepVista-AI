# Copy this file to .env and fill in what you have.
# Nothing here is required to run the prototype — every value has a safe fallback.

# Server ---------------------------------------------------------------
PORT=4000

# Question Generation Engine (Section 9 / 45 / 46) ---------------------
# Leave ANTHROPIC_API_KEY blank to run in TEMPLATE + BANK-FALLBACK mode
# (fully functional, no external calls). Fill it in later to let the
# Generation Engine call a real LLM for novel question generation.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# GENERATION_MODE: auto | template | bank_only
#   auto      -> use the LLM if ANTHROPIC_API_KEY is set, else template/bank
#   template  -> never call the LLM, even if a key is present
#   bank_only -> never generate; only ever select from the validated bank
GENERATION_MODE=auto

# Retention check interval (Section 24). A real deployment would use days/
# weeks; this is shortened to seconds so retention behavior is observable
# in a live demo without waiting.
RETENTION_INTERVAL_SECONDS=120
