# Copy this file to .env and fill in only what you're ready to use.
# Everything below is optional - the service runs with all of it blank.

PORT=4000

# --- Optional AI assistance (see src/ai/aiProvider.js) ---
# Leave AI_PROVIDER=rule_based (or unset) to run with zero setup.
# Set to "anthropic" + fill in ANTHROPIC_API_KEY to enable:
#   - classifying requirement text the rule-based matcher couldn't map
#   - phrasing the (already-decided) recommendation in plainer English
# The AI is never the authority on eligibility, fit, or the recommendation
# itself - see spec section 66 (AI ROLE) and README "Recommendation logic".
AI_PROVIDER=rule_based
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional real database ---
# Left blank on purpose - the in-memory store (src/db/memoryStore.js) is used
# until this is set and a real adapter is wired in. See schema.sql and the
# README section "Wiring into the real ACEAPT".
DATABASE_URL=
