# Copy this file to .env and fill in the values for your environment.
# Nothing in this file is required to run the ACEAPT Adapt MVP locally -
# it runs fully on deterministic logic + seeded evidence with no external
# services. Fill these in only when you wire up real integrations.

# Port the Express API listens on.
PORT=4000

# Origin allowed to call this API in dev (the Vite frontend).
CORS_ORIGIN=http://localhost:5173

# --- Placeholders for you to fill in later ---

# Optional. If set, the explanation layer (src/ai/client.ts) will use this
# to ask Claude to rewrite the deterministic "why" explanation in more
# natural language. If left blank, ACEAPT Adapt falls back to its built-in
# deterministic explanation templates and works exactly the same way,
# minus the extra polish. Never required for the engine's decisions -
# see src/ai/client.ts and section 38 of the master prompt.
ANTHROPIC_API_KEY=

# Placeholder for wiring this module into PrepVista's real authentication.
# Currently unused - see src/middleware/studentContext.ts.
JWT_SECRET=

# Placeholder for swapping the in-memory/JSON store (src/db/store.ts) for
# your real database once you're ready to integrate.
DATABASE_URL=
