# Copy this file to .env and fill in what you have. Everything works with
# these left blank — AI-generated explanations just fall back to
# deterministic templates (see src/engine/explanationEngine.ts).

# Anthropic API key, used only to generate/polish student-facing
# retention explanations and recovery-step copy. Leave blank to run in
# fully deterministic fallback mode.
ANTHROPIC_API_KEY=

# Which Claude model to use for explanations if a key is set.
ANTHROPIC_MODEL=claude-sonnet-5

PORT=4000

# When true, POST endpoints accept a simulatedDaysAgo / simulatedDaysLater
# field so the demo can show delayed verification without waiting real
# days. Set to false in any real deployment.
DEMO_MODE=true
