# ACEAPT Readiness Simulator — environment configuration
# Copy this file to .env.local and fill in what you need.
# The simulator runs fully without any of these set — deterministic
# scoring, readiness, and PATH/ADAPT logic never depend on the AI key.

# Optional. Powers a personalized qualitative debrief paragraph on the
# result page and light scenario-wording variation. Leave blank to run
# on deterministic templated explanations only (fully functional without it).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Where the MVP JSON persistence layer stores its data files.
# Swap lib/db/store.ts for a real database client in production — nothing
# above the repository layer needs to change (see README > Data model).
DATA_DIR=./data
