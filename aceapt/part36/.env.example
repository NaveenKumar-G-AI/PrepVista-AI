# ============================================================
# ACEAPT — Feature 36: Career Execution Intelligence
# Environment configuration
#
# Copy this file to .env.local and fill in the blank values.
# The app runs and the full execution loop works with these
# left blank — the AI layer degrades gracefully to deterministic
# rationale/decomposition (see src/lib/ai/client.ts). Fill in
# ANTHROPIC_API_KEY when you want AI-generated rationale, goal
# decomposition, blocker interpretation, and weekly narratives.
# ============================================================

# Anthropic API key (leave blank for now — deterministic fallback
# logic is used automatically until this is set).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for the AI intelligence layer (rationale generation,
# goal decomposition, blocker interpretation, weekly narratives).
ANTHROPIC_MODEL=claude-sonnet-5

# Secret used to sign session JWTs. Leave blank in dev (an insecure
# default is used and a warning is logged) — set a long random
# value before deploying anywhere real.
JWT_SECRET=

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/aceapt.db

# Port for `npm run dev` / `npm run start`.
PORT=3000
