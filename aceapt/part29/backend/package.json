{
  "name": "aceapt-feature29-align-engine",
  "version": "1.0.0",
  "description": "ACEAPT Feature 29 — ALIGN: capability-to-opportunity alignment engine (standalone module)",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "node dist/db/runMigrations.js",
    "migrate:dev": "ts-node src/db/runMigrations.ts",
    "seed": "ts-node src/config/seedTargetProfiles.ts",
    "test": "node --test --require ts-node/register \"src/__tests__/**/*.test.ts\"",
    "test:build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "@anthropic-ai/sdk": "^0.27.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6"
  }
}
