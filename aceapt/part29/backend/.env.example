# ============================================================================
# ACEAPT FEATURE 29 — ALIGN — environment template
# Copy to .env and fill in. Every value below is intentionally left blank —
# nothing here is a working credential.
# ============================================================================

# --- Postgres (same instance the rest of ACEAPT uses) ----------------------
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Alternatively, a single connection string (takes precedence if set):
DATABASE_URL=

# --- Service ----------------------------------------------------------------
PORT=4029
NODE_ENV=development

# Studio-signed key this service trusts for calling its API. Whatever your
# real ACEAPT auth layer issues — this module only verifies, it doesn't mint.
ALIGN_SERVICE_JWT_SECRET=

# --- Anthropic (explanation layer only — never scores anything) -------------
# If left blank, explanationService.ts automatically falls back to the
# deterministic template narrator. Nothing breaks without a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Outbox / signal bus -----------------------------------------------------
# Set to "true" once Feature 26 (ADAPT) and Feature 28 (PROOF) have real
# outbox consumers wired up. Until then the outbox table fills durably and
# nothing is lost — see docs/INTEGRATION.md.
OUTBOX_DISPATCH_ENABLED=false

# Inbound webhook shared secret — the real Feature 28 (PROOF) module should
# sign its "ProofCompleted" callback with this so /align/webhooks/proof-completed
# can verify it. Leave blank in dev; the route will skip verification and log
# a warning.
PROOF_WEBHOOK_SECRET=
