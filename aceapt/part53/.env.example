# Copy this file to .env and fill in your own values.
# Nothing here is required to run the test suite or the in-memory demo —
# every value defaults to "off" / heuristic-only behavior when left blank.

# Optional. Enables the AI-assisted validator (clarity + skill-alignment SIGNAL only —
# by design it can never be the sole source of truth for correctness, see src/validators/aiValidator.ts).
# Leave blank to run deterministic-only validation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional. Wire this up once you swap the in-memory repository (src/db/memoryRepository.ts)
# for a real adapter implementing src/db/repository.ts against db/schema.sql.
DATABASE_URL=

# Salt used to pseudonymize student ids before they are ever written to a QuestionReport row.
# Set this to a long random string in any real deployment.
REPORT_HASH_SALT=

# Demo-only auth stand-in read by src/api/middleware.ts. Replace with real session/JWT
# verification before this touches production traffic — see README "Security" section.
DEMO_ADMIN_TOKEN=
