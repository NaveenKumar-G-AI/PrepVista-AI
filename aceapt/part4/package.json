{
  "name": "aceapt-feature4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "test:unit": "node --import tsx --test tests/unit/**/*.test.ts tests/unit/**/*.test.tsx",
