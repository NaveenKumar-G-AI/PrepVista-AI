# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Dev-only auth shortcut — trusts an x-student-id header instead of a real
# session/JWT. See src/plugins/auth.ts. Set to false once real auth is wired.
DEMO_MODE=true

# ── Database (Postgres, RLS-enforced) ───────────────────────────────────────
# Two connection strings on purpose:
#  - MIGRATION_DATABASE_URL: a superuser/owner role, used only by
#    scripts/migrate.ts to create tables/policies/functions.
#  - DATABASE_URL: the actual application role. It must NOT be a superuser
#    and must NOT have BYPASSRLS — the app should be exactly as constrained
#    as an attacker who obtained its credentials. See migrations/ for the
#    role RLS is tested against.
MIGRATION_DATABASE_URL=
DATABASE_URL=

# ── AI content provider (optional) ──────────────────────────────────────────
# Leave blank to run entirely on the deterministic fallback templates in
# src/domain/aiContent.ts — this is the default and the demo works fully
# without it. Groq's API is OpenAI-compatible, so this uses the `openai`
# SDK pointed at Groq's base URL.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
