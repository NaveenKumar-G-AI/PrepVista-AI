{
  "name": "aceapt-feature6-backend",
  "version": "0.1.0",
  "description": "ACEAPT Feature 6 - Intelligent Assessment, Exam Simulation & Readiness Engine (backend service)",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/db/seed-data && cp src/db/schema.sql dist/db/schema.sql && cp src/db/seed-data/questions.json dist/db/seed-data/questions.json",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "demo": "tsx src/scripts/e2e-demo.ts",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
