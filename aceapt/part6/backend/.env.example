# Copy this file to .env and fill in real values before deploying.
# The server runs with zero configuration for local/demo purposes -
# every value below has a safe development fallback in src/config/env.ts.

# HTTP port the API listens on
PORT=4000

# Where the SQLite database file is stored
DATABASE_PATH=./data/aceapt.sqlite

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign auth tokens once real auth is wired in (see src/middleware/auth.ts).
# Currently unused by the stub auth middleware - required before production use.
JWT_SECRET=

# Optional. If set, enables LLM-assisted natural-language polish of diagnosis wording
# (src/services/insightWordingService.ts). All readiness/scoring/analysis math is
# deterministic and works fully without this key - it only affects sentence phrasing.
ANTHROPIC_API_KEY=

NODE_ENV=development
