# Copy this file to .env and fill in the blanks. Nothing below is a working
# secret - everything sensitive ships blank on purpose. See README.md
# "Configuration" for what each key is for.

NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/shortcuts.db

# --- Auth --------------------------------------------------------------
# Leave blank in development to use the x-dev-* header fallback (see
# src/api/middleware/auth.ts). MUST be set to a real, random secret before
# this service is exposed outside your machine.
JWT_SECRET=
ALLOW_DEV_AUTH=true

# --- AI (optional) -------------------------------------------------------
# Personal Shortcut Library works fully without this (see
# src/integrations/aiClient.ts - AI is never authoritative for validation
# or trust). Fill in AI_API_KEY to enable AI-assisted plain-language
# explanations for newly discovered candidate strategies.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Multi-tenant default -------------------------------------------------
# Used only by the dev-auth fallback and the seed/demo scripts.
DEFAULT_TENANT_ID=dev-tenant

# --- Integration endpoints for other ACEAPT features (blank placeholders) -
# Feature 57 is built to call out to these once they exist; until then the
# stub clients in src/integrations/*.ts return null/UNKNOWN safely.
FORMULA_SERVICE_URL=
SKILL_SERVICE_URL=
QUESTION_FAMILY_SERVICE_URL=
DIFFICULTY_SERVICE_URL=
NOVELTY_SERVICE_URL=
MISTAKE_INTELLIGENCE_SERVICE_URL=
