# ACEAPT Feature 7 — backend config
# Copy this file to `.env` and fill in values when you have them.
# Everything below is optional — the service runs with zero config using
# local mocks/fallbacks, per §35/§38/§39 of the product plan (AI and external
# integrations sit on top of deterministic logic, never in place of it).

# Server -----------------------------------------------------------------
PORT=4007

# Database -----------------------------------------------------------------
# Left blank on purpose. With no DATABASE_URL, Feature 7 persists to a local
# JSON file at backend/data/store.json (see src/db/JsonStore.ts) so it runs
# with zero setup. Point this at a real Postgres/Mongo connection string
# when you're ready — swap the implementation behind src/db/repositories.ts
# and nothing else in the codebase needs to change.
DATABASE_URL=

# AI-assisted explanations (§14, §38) --------------------------------------
# Left blank on purpose. Without a key, "why this?" explanations and the
# progress-story narrative use deterministic templates built from the same
# evidence (see src/services/interventionAndExplanation.ts). Add a key to
# upgrade explanations to natural-language generation — nothing else changes.
ANTHROPIC_API_KEY=

# Feature 5 — Adaptive Practice integration (§35) --------------------------
# Left blank on purpose. Without a URL, StudentAction dispatch uses a local
# mock session so the full loop can still be demoed end-to-end.
FEATURE5_API_URL=
FEATURE5_API_KEY=

# Feature 6 — Assessment + Exam Simulation integration (§35) ---------------
# Left blank on purpose. Without a URL, evidence and reassessment calls read
# from the local store (seeded with a demo student).
FEATURE6_API_URL=
FEATURE6_API_KEY=

# Auth ----------------------------------------------------------------------
# Left blank on purpose. Wire this up to ACEAPT's existing auth/session
# layer — Feature 7 does not implement its own authorization (§38: AI/this
# layer must not arbitrarily control authorization or student data access).
JWT_SECRET=
