# Copy this file to .env and fill in real values. Nothing here is guessed —
# every value is intentionally left blank.

PORT=4000
NODE_ENV=development

# Optional. If blank, position statements are generated with the deterministic
# template adapter (src/ai/narrativePort.ts) — no external call, no fabrication
# risk, works out of the box. If set, an LLM is used ONLY to phrase a sentence
# from facts already computed from real evidence; it is never allowed to add
# facts, and any failure falls back to the template adapter automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Placeholder for wiring the in-memory data source over to your real
# database later (see src/data/inMemoryRepository.ts and README.md).
DATABASE_URL=

# Optional. Used by src/middleware/auth.ts once you replace the stub guard
# with real session/JWT verification.
AUTH_JWT_SECRET=
