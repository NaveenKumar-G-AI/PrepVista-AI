# Copy to .env and fill in your own values. Nothing here is a real secret —
# every value below is either blank or a non-secret default.

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=

# Used only by `npm run migrate` and `npm run seed` — CREATE ROLE / CREATE
# POLICY need a privileged Postgres role, which the runtime app roles
# (below) deliberately do not have.
PGSUPERUSER=
PGSUPERUSER_PASSWORD=

# Runtime roles created by migrations/002_roles_and_rls.sql. Set their
# passwords once via:
#   psql -c "ALTER ROLE difficulty_app PASSWORD '...';"
#   psql -c "ALTER ROLE difficulty_student_app PASSWORD '...';"
# then put the same values here.
DIFFICULTY_APP_DB_USER=difficulty_app
DIFFICULTY_APP_DB_PASSWORD=
DIFFICULTY_STUDENT_APP_DB_USER=difficulty_student_app
DIFFICULTY_STUDENT_APP_DB_PASSWORD=

PORT=4055
NODE_ENV=development

# Optional. Leave blank to run on the deterministic structural/template
# fallback everywhere an AI-assisted initial estimate would otherwise be
# used (src/ai/initial-difficulty-ai.adapter.ts) — nothing breaks without
# this, it's an enhancement, not a dependency.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-4-5-20251001 if unset — this task (a rough
# initial-difficulty rationale) doesn't need a larger model. Override if
# your account uses a different model string.
ANTHROPIC_MODEL=

# TODO(integration): replace src/api/middleware/auth.ts with ACEAPT's real
# session/JWT verification. Until then this secret signs/verifies the
# reference implementation's own tokens.
AUTH_JWT_SECRET=

WORKER_POLL_INTERVAL_MS=5000
