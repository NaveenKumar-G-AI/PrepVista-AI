# ACEAPT Feature 41 — Adaptive Career Strategy Engine
# Copy to .env and fill in. Every value below is intentionally left blank.
# Nothing in this codebase hardcodes a secret — everything is read from these
# variables at runtime, so leaving them blank is safe (the affected features
# degrade gracefully; see README "Running with nothing configured").

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (Postgres). Leave blank to run on the in-memory store instead. ---
DATABASE_URL=
FEATURE41_STORE=memory
# Set FEATURE41_STORE=postgres once DATABASE_URL is set and you've run
# db/migrations/001_feature41_schema.sql against your real ACEAPT database.

# --- LLM (narrative recommendation layer only — all scoring/ranking is
# deterministic and works with this blank). Leave blank to run in
# deterministic-only mode. ---
ANTHROPIC_API_KEY=
FEATURE41_LLM_MODEL=claude-sonnet-5

# --- Auth ---
# The auth middleware in src/middleware/index.ts is a DEV-ONLY placeholder
# (reads a plain x-student-id header). Replace it with ACEAPT's real
# session/JWT auth before this touches real student data. If/when you wire in
# real JWT auth, put the signing secret here — nothing currently reads it.
JWT_SECRET=
