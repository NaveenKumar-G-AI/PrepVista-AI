# Copy this file to `.env` in the same folder (server/.env) and fill in what you need.
# Every value is intentionally blank. The app runs with all of them blank:
# the LLM layer falls back to deterministic templates, and auth runs in a
# clearly-logged dev mode that trusts the x-student-id header.

# Anthropic API key. Leave blank to use template-based explanations/hints/
# feedback instead of LLM-generated ones (see server/src/llm/llmService.ts).
ANTHROPIC_API_KEY=

# Which Claude model to call for the natural-language layer (explanations,
# hints, wording variation, error feedback). Only used if ANTHROPIC_API_KEY is set.
LLM_MODEL=claude-sonnet-5

# Secret used to sign/verify the placeholder per-student auth token
# (server/src/middleware/auth.ts). Leave blank for local/demo use only.
JWT_SECRET=

# Port the API server listens on.
PORT=4000

# Origin allowed to call the API in dev (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
