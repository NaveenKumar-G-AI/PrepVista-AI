{
  "name": "aceapt-feature16-server",
  "version": "0.1.0",
  "private": true,
  "description": "ACEAPT AI - Feature 16: Adaptive Learning Intervention & Recovery Engine (server)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "demo": "tsx src/demo/runDemoScenario.ts",
    "demo:build": "node dist/demo/runDemoScenario.js",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
