# ACEAPT Feature 27 (Forecast) — environment config
# Copy to .env and fill in. Everything below is intentionally blank/default —
# nothing here was invented; wire these to your real infra when you integrate.

# --- Server ---
PORT=4027
NODE_ENV=development

# --- Database (used once InMemoryForecastRepository is swapped for a real one) ---
# See src/repository/forecastRepository.ts for the interface to implement.
DATABASE_URL=

# --- Platform auth (used once the dev auth fallback in src/api/middleware.ts is removed) ---
# Whatever your existing PrepVista auth issues (JWT public key, session secret, etc).
AUTH_JWT_PUBLIC_KEY=
AUTH_SERVICE_URL=

# --- AI explanation layer (optional) ---
# Feature 27's numbers (readiness/forecast/risk) are ALWAYS deterministic — see
# src/engines/*. The AI layer only rephrases already-computed evidence into more
# natural language for the "Why" panel. Leave AI_PROVIDER_ENABLED=false (or leave
# the API key blank) and the system falls back to the deterministic explanation
# text automatically — nothing is broken by leaving this blank.
AI_PROVIDER_ENABLED=false
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_BASE_URL=https://api.anthropic.com/v1/messages

# --- Forecast tuning ---
# How long a cached forecast snapshot is considered "fresh" before recompute.
FORECAST_CACHE_MAX_AGE_MS=1800000
# Default projection horizon (weeks) when a student has no target assessment date.
DEFAULT_FORECAST_HORIZON_WEEKS=3
