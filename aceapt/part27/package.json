{
  "name": "aceapt-forecast",
  "version": "0.1.0",
  "private": true,
  "description": "ACEAPT Feature 27 (Forecast) — predictive readiness, trajectory, risk and scenario engine for PrepVista. Integration-ready module: deterministic engines + orchestrator + API + tests, with clearly marked seams for the real PrepVista/ACEAPT platform.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
