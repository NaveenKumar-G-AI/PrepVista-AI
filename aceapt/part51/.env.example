# ── ACEAPT Feature 51 — Accuracy Training Engine ────────────────────────────
# Copy this file to .env and fill in the blanks. Nothing here is a real secret;
# this file only exists to show which values the service expects.

# Server
PORT=4051
NODE_ENV=development

# Postgres — point these at your real ACEAPT database (or a dedicated schema).
# Three roles are expected, matching the RLS pattern used across ACEAPT features:
#   OWNER_*   – runs migrations, owns the tables (kept OUT of the RLS policies —
#               a table owner bypasses its own RLS by default in Postgres, so
#               the app must never connect as the owner at request time)
#   APP_*     – used by the API server for normal per-student requests;
#               RLS-bound via the app.student_id session variable
#   SERVICE_* – used for background/system jobs (outbox dispatch, cross-student
#               reporting); RLS-bound via a broader "service" policy
PGHOST=
PGPORT=5432
PGDATABASE=

OWNER_PGUSER=
OWNER_PGPASSWORD=

APP_PGUSER=
APP_PGPASSWORD=

SERVICE_PGUSER=
SERVICE_PGPASSWORD=

# AI (optional). Used ONLY for natural-language explanation / feedback wording —
# never for correctness, scoring, or accuracy math (see src/domain, which is 100%
# deterministic and has zero dependency on this key).
# If this is left blank, AccuracyAIAdapter automatically falls back to the
# deterministic template-based explanations in src/ai/promptTemplates.ts —
# the product keeps working end to end with no key configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Auth (placeholder — wire this to ACEAPT's real auth/session system).
# Feature 51 has no auth system of its own; auth.ts just verifies a bearer
# token was presented and trusts req.studentId from it. Replace verifyToken()
# in src/api/middleware/auth.ts with the real ACEAPT session/JWT verification.
AUTH_SHARED_SECRET=
