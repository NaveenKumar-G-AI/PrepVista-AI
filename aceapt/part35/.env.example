# Copy this file to .env.local and fill in your own values.
# Nothing in this repo will work with real AI narration until ANTHROPIC_API_KEY is set —
# the app runs and is fully usable without it (deterministic fallback copy is used instead).

# Required for AI-narrated outcome summaries / recovery rationale / feedback classification.
# Get a key at https://console.anthropic.com — leave blank to run on deterministic copy only.
ANTHROPIC_API_KEY=

# Optional — overrides the default model used for narrative generation.
# Defaults to claude-sonnet-5 if unset. Use claude-haiku-4-5-20251001 for lower cost at scale.
AI_MODEL=

# Optional — swap in ACEAPT's real identity/session lookup later.
# Until then, DEV_STUDENT_ID pins the single demo student the app resolves as "current user".
DEV_STUDENT_ID=
