# Copy this file to .env and fill in what you need. Nothing here is required
# to run the app — every value has a safe fallback (see README).

PORT=4000

# Optional. If set, intervention explanations are rephrased through the
# Anthropic API for a more natural tone. If blank (default), the app uses
# the deterministic template in src/engine/explanation.ts, which is grounded
# directly in structured evidence and works with zero configuration.
ANTHROPIC_API_KEY=
