// SS55 Data Model - mirrors the conceptual entities from the spec.
//
// This is NOT wired to a live database in this delivery - the demo runs
// against InMemoryForecastRepository instead (see
// src/repositories/forecastRepository.ts). Point DATABASE_URL at your
// real Postgres and run `prisma migrate dev` once you're ready, then
// implement ForecastRepository against @prisma/client - no other file
// needs to change.
//
// IMPORTANT: if ACEAPT already has equivalent tables (e.g. an existing
// assessment_result or student_skill_score table), reuse those and
// treat this file as a starting point, not a mandate - the spec (SS55)
// explicitly says not to create duplicate models where equivalents
// already exist.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Forecast {
  id              String    @id @default(cuid())
  studentId       String
  targetId        String?
  type            String
  status          String
  predictedValue  Float?
  confidence      String
  confidenceScore Float?
  evidenceCount   Int
  dataWindowStart DateTime?
  dataWindowEnd   DateTime?
  modelVersion    String
  trajectory      String
  momentum        String
  volatility      String
  targetStatus    String
  explanation     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  evidenceItems ForecastEvidence[]
  risks         RiskSignal[]

  @@index([studentId, createdAt])
}

model ForecastEvidence {
  id           String @id @default(cuid())
  forecastId   String
  metric       String
  value        String
  contribution String
  source       String

  forecast Forecast @relation(fields: [forecastId], references: [id])

  @@index([forecastId])
}

model TrajectoryPoint {
  id        String   @id @default(cuid())
  studentId String
  metric    String
  value     Float
  timestamp DateTime

  @@index([studentId, metric, timestamp])
}

model RiskSignal {
  id            String    @id @default(cuid())
  studentId     String
  forecastId    String?
  type          String
  severity      String
  confidence    Float
  evidence      Json
  status        String
  firstDetected DateTime
  lastUpdated   DateTime
  resolvedAt    DateTime?

  forecast Forecast? @relation(fields: [forecastId], references: [id])

  @@index([studentId, status])
}

model InterventionOutcome {
  id               String   @id @default(cuid())
  studentId        String
  interventionId   String
  interventionType String
  beforeValue      Float
  afterValue       Float
  response         String
  confidence       Float
  createdAt        DateTime @default(now())

  @@index([studentId, interventionType])
}

model StudentTarget {
  id             String   @id @default(cuid())
  studentId      String
  targetScore    Float
  assessmentType String
  targetDate     DateTime
  createdAt      DateTime @default(now())

  @@index([studentId])
}
