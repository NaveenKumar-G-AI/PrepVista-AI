# Feature 10 - environment configuration
# Copy to .env and fill in per environment. Nothing here is a real secret.

# Anthropic API key used ONLY by the AI Explanation Service
# (src/ai/explanationService.ts) to turn structured forecasts into
# plain-language text. Get one at https://console.anthropic.com
# Leave blank to run on the deterministic (non-AI) explanation template -
# the engine and every number it produces work fully without this key.
ANTHROPIC_API_KEY=

# Optional override for which Claude model the explanation service calls.
# Defaults to claude-sonnet-5 if unset. Verify current model IDs at
# https://docs.claude.com/en/docs/about-claude/models/overview before
# deploying, since these change over time.
ANTHROPIC_MODEL=

# Postgres connection string for prisma/schema.prisma, once you swap the
# in-memory repository (src/repositories/forecastRepository.ts) for a
# real Prisma-backed one.
DATABASE_URL=

# Where Feature 10 posts structured risk/forecast signals for Feature 7
# to consume (see src/integrations/adapters.ts, Feature7SignalSink).
FEATURE7_SIGNAL_INTAKE_URL=

# Port for the standalone demo server (src/index.ts). Not used when this
# router is mounted into ACEAPT's existing Express app.
PORT=4010
