# Feature 37 — Career Readiness Proof Engine (backend)
# Copy to .env and fill in. Nothing here has a real value checked in.

# Postgres connection string for a dedicated schema/role, ideally scoped
# down to only the tables this feature owns (see src/db/schema.ts).
DATABASE_URL=

# Port the standalone dev server listens on. Only relevant if you run this
# as its own service rather than mounting buildReadinessRouter() into your
# existing ACEAPT app.
PORT=4037

# Comma-separated list of origins allowed to call this API directly
# (only matters if you run app.ts standalone rather than mounting the
# router into your existing, already-configured Express app).
CORS_ALLOWED_ORIGIN=

# --- Auth integration -------------------------------------------------
# This module does NOT implement authentication (see middleware/security.ts).
# It expects your existing ACEAPT auth middleware to run first and attach
# req.user = { id, tenantId, roles, permissions } before requests reach
# Feature 37's router. Put whatever your real auth system needs here
# (JWT signing key / JWKS URL / session secret / etc.) and wire it into
# your own middleware — not into this module.
# EXISTING_AUTH_JWT_SECRET=
# EXISTING_AUTH_JWKS_URL=

# --- Optional: AI-assisted explanations --------------------------------
# The engine's "why" explanations are deterministic templates by default
# (see engine/*.ts) — this is required reading before ever touching this
# key: the AI is never the source of truth for a score or a state, only an
# optional layer for more natural phrasing. Leave EXPLANATION_PROVIDER unset
# (or "deterministic") to skip this entirely; the product works fully
# without it.
EXPLANATION_PROVIDER=deterministic
# ANTHROPIC_API_KEY=
