# Copy this file to .env and fill in real values before deploying anywhere.
# Every value below is blank/placeholder - nothing here is a real secret.

# Port the API listens on.
PORT=4000

# Origin allowed to call this API (your ACEAPT frontend).
CORS_ORIGIN=http://localhost:5173

# --- Auth (placeholder - see src/middleware.js) ---
# This MVP uses one shared demo token instead of real ACEAPT auth/sessions.
# Leave blank for local development: the API runs in open "dev mode" and
# logs a warning on startup. Before any real student data touches this
# service, replace this whole mechanism with ACEAPT's real authentication
# and tenant isolation - see ARCHITECTURE.md.
DEMO_AUTH_TOKEN=

# --- AI narrative layer (optional) ---
# Leave ANTHROPIC_API_KEY blank to run entirely on deterministic fallback
# text (src/services/aiNarrative.js). Fill it in to enable natural-language
# explanations of the trajectory data that's already been computed
# deterministically - the AI is never used to produce the numbers themselves.
ANTHROPIC_API_KEY=
# Verify this against https://docs.claude.com/en/docs/about-claude/models
# before relying on it - model strings change over time.
ANTHROPIC_MODEL=claude-sonnet-5
