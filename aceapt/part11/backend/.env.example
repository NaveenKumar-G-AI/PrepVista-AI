# ACEAPT Feature 11 - Behavior Intelligence Service
# Copy this file to .env and fill in real values. Nothing below is a working
# secret - all sensitive fields are intentionally left blank per request.

PORT=4000

# Left blank on purpose - wire up a real database when ready. The ONLY file
# that needs to change to use one is src/infrastructure/inMemoryEventStore.ts
# (it implements the EventStore interface in src/domain/eventStore.ts, which
# is all the rest of the app depends on).
DATABASE_URL=

# Left blank on purpose. Only needed if you enable the optional LLM-enhanced
# narrative layer - see src/domain/explain/narrativeEnhancer.ts. Without this
# set, deterministic template explanations are used and the service is fully
# functional without it.
ANTHROPIC_API_KEY=

# Left blank on purpose - wire up real auth when ready. See
# src/api/middleware/auth.ts for the extension point and what it currently
# does as a placeholder.
JWT_SECRET=

# true = load synthetic demo students on boot (src/demo/seedEvents.ts).
# Always set to false in production.
DEMO_MODE=true
