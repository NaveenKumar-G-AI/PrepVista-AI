// ACEAPT Feature 43 -- Adaptive Diagnostic Engine
// -----------------------------------------------------------------------
// These are the ONLY new tables this feature should need (spec section 61).
// Before running this against your real database, check whether your
// existing Assessment/Session/Response models can already represent some
// of this - if so, drop the redundant model(s) below and point the
// repository adapters (src/infra/repositories) at your existing tables
// instead of these.
//
// studentId / questionId / skillId are plain strings here (logical foreign
// keys), not Prisma relations, because the real Student/Question/Skill
// models already exist in your schema and are NOT duplicated here.
// -----------------------------------------------------------------------

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdaptiveDiagnosticSession {
  id          String    @id @default(uuid())
  studentId   String
  tenantId    String?
  objective   String
  companyId   String?
  status      String // not_started | in_progress | paused | completed | abandoned
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Full serialized AdaptiveDiagnosticState (src/domain/state.ts), kept for
  // fast resume without reassembling it from the normalized tables below.
  // Treat AdaptiveSkillEvidence / AdaptiveDecisionLog as the source of
  // truth for querying and reporting; this snapshot is a resume/perf
  // optimization only, not a second source of truth.
  stateSnapshot Json

  skillEvidence AdaptiveSkillEvidence[]
  decisions     AdaptiveDecisionLog[]

  @@index([studentId])
  @@index([tenantId])
}

model AdaptiveSkillEvidence {
  id              String                    @id @default(uuid())
  sessionId       String
  session         AdaptiveDiagnosticSession @relation(fields: [sessionId], references: [id])
  skillId         String
  estimate        Float
  uncertainty     Float
  evidenceCount   Int
  correctCount    Int
  incorrectCount  Int
  capabilityLabel String
  confidenceLabel String
  isUnstable      Boolean                   @default(false)
  updatedAt       DateTime                  @updatedAt

  @@unique([sessionId, skillId])
  @@index([skillId])
}

// Transparency/observability log (spec section 70): one row per question
// the engine selected, with the mode and reasoning behind that choice.
model AdaptiveDecisionLog {
  id                  String                    @id @default(uuid())
  sessionId           String
  session             AdaptiveDiagnosticSession @relation(fields: [sessionId], references: [id])
  questionId          String
  targetSkillId       String
  mode                String // explore | investigate | verify | challenge | transfer
  reason              String
  evidenceUsedSummary String
  informationValue    Float
  selectedAt          DateTime                  @default(now())

  @@index([sessionId])
}
