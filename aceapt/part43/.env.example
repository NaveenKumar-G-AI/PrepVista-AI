# --- ACEAPT Feature 43: Adaptive Diagnostic Engine ---
# Every value below is intentionally left blank. Fill these in only when you
# wire this engine into your real ACEAPT environment. None of this is needed
# to run the in-memory demo (`npm run dev`) or the test suite (`npm test`).

# Port for the demo Express server (src/index.ts).
PORT=4000

# Your existing ACEAPT database connection string. Only needed once you swap
# the in-memory repositories in src/infra/repositories for real adapters
# backed by prisma/schema.prisma (or your own ORM) against your actual
# Student / Question / Skill / Response tables.
DATABASE_URL=

# Your existing ACEAPT auth system's verification key/secret, if wiring
# src/api/middleware/auth.ts to call out to it needs one here rather than
# importing your existing auth module directly (preferred).
AUTH_JWT_PUBLIC_KEY=

# Optional. Only used if you extend engine/insights.ts's explainSkill/"Why"
# output with an LLM call for more natural phrasing. The engine is fully
# deterministic and free of any LLM dependency by default (spec sections
# 68 and 73 both call for this).
OPTIONAL_LLM_API_KEY=
OPTIONAL_LLM_PROVIDER=

# Optional. Only needed if InMemoryAnalyticsEventPublisher (src/infra) is
# swapped for a real analytics sink (Segment, Amplitude, an internal event
# bus, etc.) per spec section 72.
ANALYTICS_WRITE_KEY=
