{
  "name": "aceapt-feature40-career-horizon-engine",
  "version": "1.0.0",
  "description": "ACEAPT Feature 40 -- Future Career & Market Evolution Intelligence Engine (Career Horizon)",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node db/migrate.ts",
    "seed": "ts-node db/seed/seed.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "ts-node tests/integration/liveHttpWalkthrough.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "node-fetch": "^2.7.0",
    "@types/node-fetch": "^2.6.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
