# =============================================================================
# ACEAPT Feature 40 -- Career Horizon Engine
# Copy this file to .env and fill in the blanks. Nothing in this file is a
# real credential -- every value below is either empty or a non-secret default.
# =============================================================================

# ---- Server ------------------------------------------------------------------
PORT=4040
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Database (aceapt_app -- the ONLY role the server should authenticate as)
# RLS depends on this NOT being the schema-owning role. See db/bootstrap-roles.sql
# and db/migrations/005_rls_policies.sql for why.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=aceapt_feature40
PGUSER=aceapt_app
PGPASSWORD=

# ---- Worker (BYPASSRLS -- offline market-intelligence batch job ONLY.
# Never set this in the HTTP-facing server's environment.)
WORKER_PGUSER=aceapt_worker
WORKER_PGPASSWORD=

# ---- AI (optional). Feature 40's classifications, gap severities, and
# confidence levels are ALWAYS computed deterministically (spec ??107-109 --
# "no fake AI", "no black box scores") and never depend on this key. When
# ANTHROPIC_API_KEY is unset, the AI layer automatically falls back to
# clearly-labeled templated explanations instead of failing or fabricating --
# see src/ai/aiClient.ts. Add a real key to upgrade explanation / narrative /
# scenario-copy quality; nothing about correctness changes without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Cross-feature integration (Features 34/36/37/38/39) ---------------------
# This standalone build talks to its own stand-in tables (see migration 001 and
# src/db/standins.ts) for those features. When wiring into the real ACEAPT
# repo, point the adapters in src/integrations/*.adapter.ts at the real
# services/tables instead and these URLs become unnecessary.
FEATURE36_ACTION_ENGINE_URL=
FEATURE36_ACTION_ENGINE_API_KEY=
