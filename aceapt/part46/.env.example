# ============================================================
# ACEAPT Feature 46 - Socratic Teaching Mode
# Copy this file to .env and fill in the blanks.
# Nothing in this project will break with these left blank -
# it runs on deterministic fallbacks until you add real values.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth (stub) ---
# dev  = reads student id from the `x-student-id` header (no real auth; local/testing only)
# jwt  = verifies a real Bearer JWT using JWT_SECRET (wire this to your real identity provider)
AUTH_MODE=dev
JWT_SECRET=

# --- Anthropic API (optional) ---
# Leave ANTHROPIC_API_KEY blank to run entirely on deterministic templates.
# When set, the AI is used ONLY to rephrase tutor messages and to give a second
# opinion on teach-back answers -- it never decides correctness or state transitions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Persistence ---
# Reference file-backed store. Swap SocraticRepository for your real DB in production.
DATA_DIR=./data

# --- Teaching policy tuning ---
MAX_HINT_LEVEL=6
MAX_TURNS_PER_STATE=4
MAX_LOOP_BACKS=2
