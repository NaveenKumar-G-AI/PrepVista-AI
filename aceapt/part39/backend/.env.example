# Copy this file to .env and fill in what you need.
# Everything below is OPTIONAL -- the app runs fully on deterministic logic
# with these left blank. Adding an Anthropic API key upgrades JD parsing,
# positioning statements, and application-answer drafting to AI-enhanced
# mode; the deterministic path stays as the automatic fallback if the call
# fails, so nothing breaks if the key is missing, wrong, or rate-limited.

# Leave blank until you're ready to enable AI-enhanced analysis.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset. Check
# https://docs.claude.com for current model names before deploying.
ANTHROPIC_MODEL=

# Server port. Defaults to 4000 if unset.
PORT=

# SQLite file location. Defaults to backend/data/aceapt.db if unset.
DB_PATH=
