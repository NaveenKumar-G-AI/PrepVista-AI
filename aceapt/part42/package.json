{
  "name": "aceapt-feature42-diagnostic-engine",
  "version": "1.0.0",
  "description": "ACEAPT Feature 42 — Advanced Aptitude Diagnostic Engine",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx db/migrate.ts",
    "migrate:down": "tsx db/migrate.ts down",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:archetypes": "vitest run tests/archetypes",
    "test:edge": "vitest run tests/edgeCases",
    "test:integration": "vitest run tests/integration",
    "test:react": "vitest run tests/react",
    "dev": "tsx watch src/api/server.ts"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "groq-sdk": "^0.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
