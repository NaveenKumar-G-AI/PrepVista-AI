# ACEAPT Feature 42 — environment template
# All secrets are intentionally left blank. Fill in for your environment.

# --- Database (SECURITY DEFINER-only access pattern — see TRUTH_TABLE.md) ---
# Owner role: runs migrations, owns tables, owns SECURITY DEFINER functions.
DIAG_DB_HOST=
DIAG_DB_PORT=5432
DIAG_DB_NAME=
DIAG_OWNER_USER=diag_owner
DIAG_OWNER_PASSWORD=

# App role: zero direct table grants, can only call SECURITY DEFINER functions
# and read the two views granted to it in 002_rls_and_roles.sql.
DIAG_APP_USER=diag_app
DIAG_APP_PASSWORD=

# --- AI explanation layer (Module 39/40) ---
# Optional. If blank, the engine silently uses the deterministic template
# fallback (src/ai/deterministicFallback.ts) — no feature is lost, only the
# prose gets less varied. Never required for correctness of any score/label.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth integration (Module 41) ---
# Feature 42 does not implement its own auth. It expects the *existing*
# ACEAPT auth middleware to populate request context with a verified
# studentId + tenantId before these routes run. See src/api/middleware/auth.ts.
AUTH_INTEGRATION_NOTE="wire this to the real ACEAPT session/JWT verifier"

# --- Server ---
PORT=4042
NODE_ENV=development
