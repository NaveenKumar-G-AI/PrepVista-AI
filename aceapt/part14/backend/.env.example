# Copy this file to .env and fill in what you need.
# Nothing here is required to run the prototype — it works fully offline
# with template-based explanations if ANTHROPIC_API_KEY is left blank.

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Optional. If set, Section 29 "why is this not mastered" explanations are
# phrased by Claude instead of the built-in deterministic template. The model
# is only ever given the already-computed evidence object — see
# src/engine/explainer.ts — it is never allowed to invent numbers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
