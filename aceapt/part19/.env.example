# ACEAPT AI — Feature 19 environment configuration
# Copy to `.env` and fill in. Nothing here has a real value — that's intentional.

# --- Server ---------------------------------------------------------------
PORT=4019

# --- Database ---------------------------------------------------------------
# Not wired up in this prototype (it runs on in-memory repositories so it
# works with zero config). Fill this in and implement Prisma-backed repos
# against prisma/schema.prisma when you're ready to persist — see
# ARCHITECTURE_ASSUMPTIONS.md "Swapping in a real database".
DATABASE_URL=

# --- AI content generation ---------------------------------------------------
# Used ONLY for generating recall-prompt / hint / micro-lesson / contrastive
# explanation TEXT (see src/ai/AIContentProvider.ts). Never used for scoring
# or state transitions — those are deterministic. Leave blank and the system
# falls back to templated text automatically; nothing breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
