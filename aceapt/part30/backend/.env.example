# ACEAPT PATH -- backend environment
# Copy this file to .env and fill in the blanks. Nothing here is a real secret.

# --- Database -------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=aceapt_path_dev

# Runtime app role. Must be the least-privilege `path_app` role that
# migration 0003_rls.sql creates -- RLS is only enforced against a
# non-superuser role. Never point the running server at PGADMIN_USER.
PGUSER=path_app
PGPASSWORD=

# Admin/owner role, used ONLY by `npm run migrate` and the tenant-creation
# step of `npm run seed`. Defaults to the local postgres superuser.
PGADMIN_USER=postgres
PGADMIN_PASSWORD=

# --- Server -----------------------------------------------------------------
PORT=4030
NODE_ENV=development

# --- AI explanation layer (Section 55) --------------------------------------
# PATH uses this ONLY to phrase explanations/rationale/summaries in natural
# language. It is never the source of truth for readiness, capability scores,
# proof, or milestone verification -- see src/ai/explanationAdapter.ts.
# Leave blank to run entirely on the deterministic template fallback.
ANTHROPIC_API_KEY=
# Pick whichever current Claude model your Anthropic account has access to.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Upstream ACEAPT systems (Section 6, 35-38) ------------------------------
# PATH orchestrates these, it does not re-implement them. This reference
# build ships mock clients (src/integrations/*) that behave like the real
# thing so PATH can be exercised end-to-end on its own. Point these at the
# real services when wiring PATH into the live ACEAPT backend.
ALIGN_SERVICE_URL=
ADAPT_SERVICE_URL=
FORECAST_SERVICE_URL=
PROOF_SERVICE_URL=

# --- Auth / tenancy ----------------------------------------------------------
# This reference build issues its own dev-only signed session stand-in
# (see src/middleware/auth.ts). Replace with the real ACEAPT auth/session
# integration when this lands in the main codebase.
SESSION_SECRET=
