# ── CodeForge Reasoning Verification Engine — environment ───────────────────
# Nothing in this file is required to run the deterministic engine or the
# test suite. It only matters once you wire in a live AI_PROVIDER.
#
# Left blank intentionally — fill in your own values.

# Which AI provider to use for the semantic layer (claim refinement, semantic
# interpretation of ambiguous reasoning, follow-up question phrasing).
# One of: mock | groq | gemini
# Defaults to "mock" when unset, so the engine runs end-to-end with zero keys.
AI_PROVIDER=mock

# Groq (OpenAI-compatible chat completions, https://api.groq.com/openai/v1)
GROQ_API_KEY=
GROQ_MODEL=

# Gemini (generateContent, https://generativelanguage.googleapis.com/v1beta)
GEMINI_API_KEY=
GEMINI_MODEL=

# Postgres connection string for the reasoning_* tables (db/schema.sql).
# Point this at your existing Supabase/Postgres instance — this module does
# not create or manage its own database.
DATABASE_URL=
