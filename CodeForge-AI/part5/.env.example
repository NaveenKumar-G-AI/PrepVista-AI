# SQLite file path for the reference build. Use ':memory:' for an ephemeral DB.
DATABASE_PATH=./data/codeforge.db

# HTTP port for the API server.
PORT=3000

# JWT signing secret for the demo auth flow. CHANGE THIS in any non-local use;
# in a real deployment this whole flow is replaced by verifying Supabase-issued
# JWTs instead (see docs/CODEFORGE_SECURITY.md).
JWT_SECRET=dev-only-secret-change-in-production

# AI provider selection: 'groq' | 'gemini' | 'none' (default). The engine is
# fully functional with 'none' — AI only polishes wording, it is never
# authoritative (see docs/CODEFORGE_FINAL_REPORT.md, section 10).
AI_PROVIDER=none
GROQ_API_KEY=
GEMINI_API_KEY=
