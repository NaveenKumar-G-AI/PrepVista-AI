{
  "name": "codeforge-adaptive-engine",
  "version": "1.0.0",
  "description": "Adaptive Coding Mastery & Personalized Learning Engine for CodeForge AI",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "dev": "node --experimental-sqlite --import tsx src/api/index.ts",
    "start": "node --experimental-sqlite --import tsx src/api/index.ts",
    "demo": "node --experimental-sqlite --import tsx scripts/runDemo.ts",
    "test": "node --experimental-sqlite --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts tests/e2e/*.test.ts",
    "test:unit": "node --experimental-sqlite --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-sqlite --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "node --experimental-sqlite --import tsx --test tests/e2e/*.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/jsonwebtoken": "^9.0.7"
  }
}
