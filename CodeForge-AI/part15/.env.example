# =============================================================================
# CodeForge AI — Hint Ladder — environment configuration
# All values intentionally left blank. Fill in against YOUR real Supabase
# project and AI provider accounts. Nothing in this repo will call out to a
# live service until these are set — see README.md "Failure isolation".
# =============================================================================

# --- Supabase (reuse the same project as the rest of CodeForge) -------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers -------------------------------------------------------
# Leave blank to run in degraded/deterministic-fallback mode (see
# src/lib/hint-ladder/providers/router.ts). No provider is hardcoded;
# HINT_LADDER_PRIMARY_PROVIDER picks which one is tried first.
HINT_LADDER_PRIMARY_PROVIDER=groq

GROQ_API_KEY=
# Set to whatever current Groq-hosted model IDs you have access to.
# Intentionally NOT hardcoded in source — model availability changes.
# Check https://console.groq.com/docs/models for the current list.
GROQ_MODEL_FAST=
GROQ_MODEL_STRONG=

GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for the current list.
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=

# --- Mode policy (server-side enforced ceilings, see policy-engine.ts) ------
HINT_LADDER_MAX_LEVEL_PRACTICE=SOLUTION_ASSISTANCE
HINT_LADDER_MAX_LEVEL_ASSESSMENT=DIRECTION
HINT_LADDER_MAX_LEVEL_INTERVIEW=CONCEPT

# --- Rate limiting ------------------------------------------------------
HINT_LADDER_RATE_LIMIT_WINDOW_MS=10000
HINT_LADDER_RATE_LIMIT_MAX_REQUESTS=5
