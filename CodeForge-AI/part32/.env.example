# ------------------------------------------------------------------
# CodeForge AI - Role Skill Gap Analysis
# Copy to .env and fill in. Nothing here is a real credential.
# ------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Postgres connection for THIS feature's tables (role_skill_gap_*).
# Point this at your existing CodeForge database/pool.
DATABASE_URL=

# Existing CodeForge AI Gateway - used ONLY for the optional
# natural-language explanation layer (Phase 33). The gap engine
# itself never calls this for scoring/classification.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Existing CodeForge auth - the auth stub in src/api/middleware.ts
# is a CONTRACT PLACEHOLDER ONLY (see README "What's real vs. what's
# a stub"). Replace it with your real session/JWT verification before
# this touches production traffic.
AUTH_JWT_PUBLIC_KEY=

# Existing CodeForge event bus / queue (Kafka, SQS, BullMQ, etc.)
# Used for event-driven recalculation (Phase 57-58).
EVENT_BUS_URL=

# Existing CodeForge cache (e.g. Redis) for gap-profile caching (Phase 60).
CACHE_URL=

# Versioning (Phase 54) - bump when the deterministic algorithm changes.
GAP_ALGORITHM_VERSION=1.0.0
