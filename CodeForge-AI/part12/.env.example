# CodeForge AI — Submission System
# Copy to .env and fill in. Nothing in this file has a real value — left blank on purpose.
# Never commit the filled-in .env file.

# --- Supabase / Postgres ---------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- AI providers (explanation/evidence generation only — NEVER used to
#     decide a verdict, score, or submission status; see src/services/
#     resultAggregation.ts, which has no AI dependency at all) -------------
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Worker ------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=120
WORKER_POLL_INTERVAL_MS=750
STUCK_JOB_SWEEP_INTERVAL_MS=30000
STUCK_JOB_MAX_AGE_SECONDS=600

# --- Submission limits (see src/domain/config.ts for the typed, single
#     source of truth these map onto — nothing is hard-coded in the pipeline) --
MAX_SOURCE_SIZE_BYTES=131072
MAX_FILES_PER_SUBMISSION=20
MAX_FILE_SIZE_BYTES=131072
MAX_TOTAL_SUBMISSION_BYTES=1048576

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_SUBMISSIONS_PER_USER_PER_MINUTE=10
RATE_LIMIT_SUBMISSIONS_PER_IP_PER_MINUTE=20

# --- Execution provider ---------------------------------------------------
# "local-process" = the dev/test reference sandbox shipped in this deliverable
#                    (src/execution/localProcessExecutionProvider.ts).
#                    NOT production-secure isolation — see its file header.
# "codeforge-sandbox" = placeholder value for wiring in CodeForge's real,
#                    existing secure execution/sandbox service once this
#                    module is merged into the actual repository.
EXECUTION_PROVIDER=local-process
