# Copy to .env and fill in. Nothing here is a real value.

# Postgres connection used for READS, as the RLS-constrained `authenticated`
# role (Supabase: use the pooled connection string from your project's
# Database settings; the growth-tracking module sets the auth claim itself
# per-request, it does not need a Supabase client, just a Postgres URL).
DATABASE_URL=

# Postgres connection used for WRITES and instructor-authorization lookups,
# as a privileged role that bypasses RLS (Supabase: the `service_role`
# connection string / a role with `bypassrls`). Never expose this to any
# client-facing code path.
DATABASE_SERVICE_URL=

# Shared secret for the internal-only /internal/growth/ingest route. Rotate
# and store this the same way the rest of CodeForge stores internal service
# credentials — this is a placeholder route for this standalone build, see
# src/server/index.ts.
INTERNAL_SERVICE_KEY=

PORT=4300

# Optional: only needed if you wire up LLM-assisted phrasing in
# src/lib/growth/explain.ts (off by default — see that file).
ANTHROPIC_API_KEY=
