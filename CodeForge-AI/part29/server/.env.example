# Postgres connection string for your real database (Supabase: Project Settings -> Database -> Connection string).
# Use the pooled "Transaction" connection string for the app, and the direct connection for migrations if your
# Supabase plan requires it (DIRECT_URL below).
DATABASE_URL=
DIRECT_URL=

# Supabase project (needed only if/when this backend talks to Supabase Auth or Storage directly).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000

# AI narrative generation is optional. Leave AI_PROVIDER=none to use the deterministic
# template narrative (no external calls, no key required). Set to "groq" or "gemini" once
# you have a key — see src/ai/narrative.ts.
AI_PROVIDER=none
GROQ_API_KEY=
GEMINI_API_KEY=
