    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
