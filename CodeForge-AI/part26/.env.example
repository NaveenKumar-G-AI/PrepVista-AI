# CodeForge AI — Skill Signal Intelligence Engine
# Copy to .env and fill in. Nothing here is a real credential — local dev
# values used during build/testing are noted in comments only, never assumed
# to be what you deploy with.

# --- API server -> Postgres, connecting as the app_service role -------------
# app_service must exist (see src/db/migrations/002_rls.sql) with BYPASSRLS,
# and no direct table write grants — it reaches skill_evidence/skill_signals
# only through the SECURITY DEFINER functions in that same migration.
# Local dev during this build used: postgres://app_service:svc_local_dev_pw@localhost:5432/skillsignal
DATABASE_URL_SERVICE=

# --- Migration runner (scripts/run-migrations.mjs) --------------------------
# Needs CREATE TABLE / CREATE ROLE / CREATE FUNCTION privileges — a superuser
# or DB owner role locally. On Supabase, run migrations through the Supabase
# CLI/dashboard instead and leave this blank.
DATABASE_URL_MIGRATOR=

# --- Supabase (if deploying there instead of plain Postgres) ----------------
# On Supabase, DATABASE_URL_SERVICE should use the `service_role` connection
# (already BYPASSRLS by default — you will not need migration 002's manual
# BYPASSRLS/role-creation block; adapt it to skip role creation and keep just
# the functions + RLS policies). auth_student_id() already reads
# request.jwt.claims the same way Supabase/PostgREST sets it, so no change
# needed there.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- API auth placeholder (src/api/server.ts) --------------------------------
# Bearer token the trusted backend/upstream systems use to call POST /evidence.
# This whole scheme is a placeholder — swap parseAuthHeader() in server.ts for
# real JWT verification before any of this sees production traffic.
SERVICE_AUTH_TOKEN=

PORT=3000
