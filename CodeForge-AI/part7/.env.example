# --- Postgres (local dev values already match the sandbox setup) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=codeforge
PG_ADMIN_USER=codeforge_admin
PG_ADMIN_PASSWORD=admin_local_dev_pw
PG_APP_USER=codeforge_app
PG_APP_PASSWORD=app_local_dev_pw

# --- AI providers (OPTIONAL — the engine works fully without these; only
#     the qualitative report narrative degrades to a template. See
#     src/integrations/aiProvider.ts. Replace with real keys.) ---
GROQ_API_KEY=REPLACE_WITH_REAL_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=REPLACE_WITH_REAL_GEMINI_KEY
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER_ORDER=groq,gemini
