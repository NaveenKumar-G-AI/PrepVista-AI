# ============================================================
# Hidden Test Engine — environment configuration
# Copy to .env.local and fill in the blanks. Nothing here is
# a real credential; everything sensitive is left empty on
# purpose so you can drop in your own keys.
# ============================================================

# --- Database (Supabase Postgres or any Postgres 14+) -------
# Server-side connection used by the evaluation engine. Must be
# a privileged/service connection — never expose this to the browser.
DATABASE_URL=

# --- Supabase (if deploying on Supabase rather than plain PG) -
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only. NEVER prefix with NEXT_PUBLIC_,
# never send to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (used ONLY for test-idea generation & result
# explanation — never for deterministic verdicts) --------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Which provider to try first; the other is the fallback.
AI_PROVIDER_ORDER=groq,gemini

# --- Signing / integrity -------------------------------------
# Used to sign immutable evaluation-evidence records so tampering
# with stored results after the fact can be detected.
EVIDENCE_SIGNING_SECRET=

# --- Execution sandbox -----------------------------------------
# Absolute path to an unprivileged user the runner drops into.
# See docs/ARCHITECTURE.md#execution-isolation for setup.
SANDBOX_UNPRIVILEGED_USER=sandboxrunner
SANDBOX_SCRATCH_ROOT=/var/lib/hidden-test-engine/sandbox

# --- App -------------------------------------------------------
NODE_ENV=development
