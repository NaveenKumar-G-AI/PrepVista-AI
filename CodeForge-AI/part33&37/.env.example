# ============================================================
# PrepVista Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prepvista?schema=public"

# Redis (for caching, rate limiting, sessions)
REDIS_URL="redis://localhost:6379"

# ============================================================
# Authentication
# Generate with: openssl rand -base64 32
# ============================================================
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================
# AI Configuration
# ============================================================
# Provider: anthropic | openai
AI_PROVIDER="anthropic"
AI_API_KEY="your-anthropic-or-openai-api-key"
AI_MODEL="claude-3-5-sonnet-20241022"
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# Optional: OpenAI fallback
OPENAI_API_KEY=""

# ============================================================
# Feature Flags
# ============================================================
FEATURE_INTELLIGENCE_ENGINE=true
FEATURE_ADAPTIVE_DIFFICULTY=true
FEATURE_TPO_ANALYTICS=true
FEATURE_SKILL_GRAPH_VISUALIZATION=true

# ============================================================
# Server
# ============================================================
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info