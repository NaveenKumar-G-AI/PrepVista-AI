{
  "module": "codeforge-role-context",
  "version": "1.0.0",
  "status": "prototype",
  "description": "Role-Based Technical Identity & Career Context domain for CodeForge AI.",
  "entities": [
    "career_domain",
    "role_family",
    "role",
    "role_version",
    "competency",
    "skill",
    "skill_prerequisite",
    "technology",
    "role_competency",
    "role_skill",
    "role_technology",
    "institution",
    "role_variant",
    "student",
    "student_career_context",
    "student_role_history"
  ],
  "events_published": [
    "CODEFORGE_ROLE_SELECTED",
    "CODEFORGE_ROLE_CHANGED"
  ],
  "events_defined_not_wired": [
    "CODEFORGE_ROLE_LIST_VIEWED",
    "CODEFORGE_ROLE_SEARCHED",
    "CODEFORGE_ROLE_VIEWED",
    "CODEFORGE_ROLE_COMPARISON_VIEWED"
  ],
  "future_consumers": [
    "diagnostic",
    "challenge",
    "adaptive-learning",
    "mastery",
    "role-readiness",
    "prepvista-student-intelligence"
  ],
  "explicitly_out_of_scope": [
    "coding-challenge-execution",
    "diagnostics",
    "mastery-scoring",
    "role-readiness-calculation",
    "ai-recommendation-engine"
  ],
  "notes": "events_published are emitted by the service layer via console logging in this prototype (no message bus exists to wire into); events_defined_not_wired have named payload shapes documented in docs/FINAL_REPORT.md but are not yet emitted anywhere in the code — listed separately so this manifest doesn't overstate what runs."
}
