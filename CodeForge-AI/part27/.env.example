# ---------------------------------------------------------------------------
# CodeForge AI — Growth Intelligence module
# Copy to .env.local (or merge into the main repo's existing .env) and fill
# in real values. Nothing in this file is a real credential.
# ---------------------------------------------------------------------------

# Supabase project already used by the rest of CodeForge AI.
# This module does not create a new project — it adds tables/policies to
# the existing one via the migrations in db/migrations/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI provider for growth-insight narration only (never for authoritative
# skill state — see src/insights/README inline docs). Leave both blank to
# run in deterministic-summary-only mode; the pipeline works fully without
# either key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Which provider to prefer when both keys are present: "groq" | "gemini"
GROWTH_AI_PROVIDER=groq
