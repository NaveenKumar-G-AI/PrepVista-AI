# =============================================================================
# CodeForge AI Cost & Performance Controls — environment configuration
#
# Copy this file to `.env` and fill in real values. Nothing in this file is
# a working credential — every secret is intentionally left blank.
# Never commit a filled-in `.env` file.
# =============================================================================

# --- Service ---------------------------------------------------------------
PORT=4039
NODE_ENV=development
LOG_LEVEL=info

# --- Auth --------------------------------------------------------------
# Secret used to verify bearer JWTs issued by CodeForge's own auth system.
# This gateway does not issue tokens — it only verifies them. Point this at
# your existing identity provider's signing secret/public key when you wire
# this up to CodeForge's real auth.
JWT_SECRET=
JWT_ISSUER=

# --- Database ----------------------------------------------------------
# Postgres connection string. See migrations/001_init.sql for schema.
# Leave blank to run the gateway against the in-memory repositories
# (fine for local dev / demo; NOT for production — data does not persist
# and is not shared across instances).
DATABASE_URL=

# --- Cache / rate limit / concurrency backing store ---------------------
# Redis is required for multi-instance deployments (the in-memory
# implementations shipped here are single-process only). Leave blank to
# use in-memory implementations.
REDIS_URL=

# --- AI Providers --------------------------------------------------------
# Leave blank until you're ready to make live provider calls. With no key
# set, the corresponding provider reports itself UNAVAILABLE rather than
# failing unpredictably, and the gateway will route around it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Safe defaults (see src/config/index.ts) -----------------------------
# Applied only when no explicit budget/policy has been configured for a
# given scope. Never leave AI usage fully unbounded — see policy/PolicyEngine.
DEFAULT_DAILY_BUDGET_USD=50
DEFAULT_REQUEST_TIMEOUT_MS=30000
DEFAULT_MAX_RETRIES=2

# --- Emergency controls ----------------------------------------------------
# Extra static secret required (in addition to a PLATFORM_ADMIN role) to
# trip the global AI kill switch. Leave blank to disable the endpoint
# entirely until you set one.
EMERGENCY_CONTROL_PASSPHRASE=
