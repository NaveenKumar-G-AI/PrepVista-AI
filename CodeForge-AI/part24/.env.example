# Fill these in yourself — nothing is hardcoded and the service runs fine
# with all of them blank (AI enrichment silently no-ops; correctness/quality
# evidence just won't be available until real providers are wired in).

# --- AI providers (src/ai/providers.ts) ---
# Only one is needed. If both are blank, selectProvider() falls back to a
# mock that returns zero AI findings — deterministic findings still work.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Database (only used once you swap src/api/store.ts for Postgres) ---
DATABASE_URL=

PORT=8787
