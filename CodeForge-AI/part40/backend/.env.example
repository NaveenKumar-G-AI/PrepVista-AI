# ==============================================================================
# CodeForge Feature 40 — Security, Audit & Reliability Layer
# Environment configuration template
#
# Copy to .env and fill in real values. Nothing in this file is a working
# credential — every secret below is intentionally blank. env.ts fails closed
# (refuses to start) if a required value is missing outside NODE_ENV=test.
# ==============================================================================

NODE_ENV=development
PORT=4040
SERVICE_NAME=codeforge-feature40

# ---- Database -----------------------------------------------------------
# Least-privilege runtime connection used by the app at request time.
# Must point at a role that owns NO tables (see db/migrations/007_rls_policies.sql) —
# this is what makes Postgres RLS tenant-isolation actually apply to app traffic.
DATABASE_URL=

# Elevated connection used ONLY by `npm run migrate` to create tables / policies /
# grants. Never used by the running API. Keep this out of the app's normal runtime
# environment in production (e.g. a separate CI/deploy secret).
DATABASE_ADMIN_URL=

# ---- Identity -------------------------------------------------------------
# CodeForge already authenticates users via Supabase; Feature 40 does not
# reimplement login. This is the shared secret Supabase signs access-token
# JWTs with (Project Settings -> API -> JWT Secret), used only to verify
# tokens and build the server-side IdentityContext. If your Supabase project
# uses asymmetric (RS256/JWKS) signing instead, set SUPABASE_JWKS_URL and
# leave this blank — see src/middleware/identity.ts.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Seconds since auth_time within which a session counts as "recently
# authenticated" for step-up-gated admin actions (see requireRecentAuth).
RECENT_AUTH_WINDOW_SECONDS=900

# ---- Notifications ----------------------------------------------------
# Left blank on purpose. NotificationAdapter falls back to a console/no-op
# channel until these are set — see src/adapters/notificationAdapter.ts.
ALERT_EMAIL_FROM=
ALERT_EMAIL_PROVIDER_API_KEY=

# ---- Feature 39 (AI Gateway) integration -------------------------------
# Feature 40 does not own AI provider credentials — Feature 39 does. Left
# blank here; only used by the mock adapter in tests. Wire
# src/adapters/aiProviderAdapter.ts to the real Feature 39 client in-repo.
AI_GATEWAY_INTERNAL_URL=

# ---- Rate limiting / abuse detection ------------------------------------
RATE_LIMIT_LOGIN_MAX_PER_15M=10
RATE_LIMIT_DEFAULT_MAX_PER_MIN=120

# ---- CORS -----------------------------------------------------------------
# Comma-separated EXACT origins allowed to call this API from a browser.
# Left blank on purpose: production must not fall back to "*". Example:
# CORS_ALLOWED_ORIGINS=https://app.codeforge.example,https://admin.codeforge.example
CORS_ALLOWED_ORIGINS=

# ---- Retention (days) -----------------------------------------------------
AUDIT_RETENTION_DAYS=730
SECURITY_EVENT_RETENTION_DAYS=365
