# Copy to .env and fill in real values. Nothing here is a working secret.

NODE_ENV=development
PORT=4038

# --- Data layer ---------------------------------------------------------
# Reference build uses Node's built-in SQLite (file-backed). Point production
# at the org's existing Postgres via the same repository-pattern data-access
# layer in src/db/ and src/services/report-repository.ts.
SQLITE_FILE_PATH=./data/feature38.sqlite

# --- Auth ----------------------------------------------------------------
# PLACEHOLDER auth. Replace src/http/middleware.ts's requireAuth with
# CodeForge's real session/JWT/OAuth verification. This secret only signs
# the placeholder demo tokens used by scripts/tests in this reference build.
AUTH_JWT_SECRET=

# --- AI narrative (optional) ---------------------------------------------
# Leave blank to run the deterministic fallback narrative path (this is the
# default and is fully supported — see docs/ARCHITECTURE.md "AI Safeguards").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Report versioning -----------------------------------------------------
# Bump only when the report schema/template itself changes (see domain/enums.ts
# REPORT_SCHEMA_VERSION, which mirrors this — kept here for deployment visibility).
REPORT_SCHEMA_VERSION=1.0.0
