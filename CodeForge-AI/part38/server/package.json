{
  "name": "@codeforge/feature-38-technical-mastery-report",
  "version": "0.1.0",
  "private": true,
  "description": "CodeForge Feature 38 — Technical Mastery Report: reporting/presentation layer over existing CodeForge technical intelligence.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "worker": "tsx watch src/jobs/worker-entry.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "preview": "tsx scripts/render-preview.ts",
    "pdf:sample": "tsx scripts/generate-sample-pdf.ts",
    "test": "vitest run && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "tsx test/integration/run-golden.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "zod": "^3.23.8",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "vitest": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "@types/node": "^22.5.0"
  }
}
