# Copy to .env and fill in. Every value below is intentionally left blank.
# The service is designed to run with ALL of these unset:
#   - no DATABASE_URL  -> falls back to the in-memory repository (good for local dev/demo)
#   - no AI provider keys -> AIProviderRouter reports UNAVAILABLE and DebuggingCoach
#                            falls back to deterministic, evidence-derived hints
#   - no JWT_SECRET -> devAuth middleware issues a single demo user (NOT for production)

PORT=

# --- Database (Postgres / Supabase). See db/schema.sql for the migration. ---
DATABASE_URL=

# --- AI providers. Tried in this order by AIProviderRouter; any subset may be blank. ---
GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Auth integration point (see src/api/app.ts::devAuthMiddleware). ---
# Replace devAuthMiddleware with CodeForge's real auth/session middleware in production.
JWT_SECRET=

# --- Sandbox execution limits (sane defaults are used if unset; see src/sandbox/executor.ts) ---
SANDBOX_WALL_TIME_MS=
SANDBOX_CPU_TIME_SEC=
SANDBOX_MEMORY_KB=
SANDBOX_MAX_PROCESSES=
