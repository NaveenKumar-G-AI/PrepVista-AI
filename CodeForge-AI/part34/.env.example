# ============================================================================
# CodeForge AI — Feature 34: Technical Interview Integration
# Copy this file to .env and fill in the blanks. Nothing here has a default
# value baked into the code — see src/integration/adapters/aiGateway.ts and
# systemAdapters.ts for exactly how each one is read.
# ============================================================================

# Required for live AI-generated questions and evaluations. Without this,
# the app runs on the deterministic fixture adapter (no network calls, no
# cost) — safe for local dev and CI, not for real interviews.
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Port for the standalone dev server (src/api/server.ts). Not used when this
# router is mounted into an existing host app instead.
PORT=3034

# ---- Not yet wired to any code — placeholders for when this integrates ----
# ---- into the real CodeForge database and speech infrastructure.       ----

# Postgres connection string for the migrations in src/db/migrations/.
# DATABASE_URL=

# Speech-to-text / text-to-speech provider credentials for
# src/integration/adapters/systemAdapters.ts's UnconfiguredVoiceAdapter —
# replace that adapter with a real one once you have these.
# VOICE_PROVIDER_API_KEY=
