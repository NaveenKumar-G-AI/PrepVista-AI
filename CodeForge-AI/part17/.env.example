# ---- AI explanation layer (optional) ----
# Set exactly one. If neither is set, POST /analyze still returns a
# complete, correct deterministic report — ai_explanation just stays
# null instead of the request failing.
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile      # verify current model id in Groq's docs before deploying
# GEMINI_MODEL=gemini-2.0-flash            # verify current model id in Gemini's docs before deploying

# ---- Auth ----
# Your auth provider's JWT secret (e.g. your Supabase project's JWT
# secret). Until this is set, the API runs in DEV MODE: every request
# is treated as a fixed "dev-user" with no token required. Do NOT
# deploy with this unset.
JWT_SECRET=
JWT_AUDIENCE=authenticated

# ---- Persistence ----
# Path to a SQLite file, or ":memory:" for a throwaway in-memory DB
# (fine for trying this out; not for production). Point a real
# deployment at Postgres/Supabase by swapping the driver in
# complexity_engine/persistence/store.py for asyncpg/psycopg2 against
# complexity_engine/persistence/schema_postgres.sql — see README.
COMPLEXITY_DB_PATH=:memory:
