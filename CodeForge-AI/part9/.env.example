# Postgres connection string (Supabase: use the "connection pooling" URI for serverless, direct URI otherwise)
DATABASE_URL=postgres://user:password@localhost:5432/codeforge_mastery

# Optional. If unset, AIProviderRouter falls back to deterministic text — nothing breaks.
GROQ_API_KEY=
GEMINI_API_KEY=

PORT=3001
NODE_ENV=development
