# Copy to .env and fill in. Every value below is intentionally blank.
# The engine degrades gracefully when these are unset:
#   - no AI keys      -> falls back to the offline MockProvider (deterministic engine still fully works)
#   - no DATABASE_URL -> persistence is skipped with a log line, analysis still returns normally

# --- AI providers (existing CodeForge AI-provider abstraction should own these in the real app) ---
GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# --- Database (Supabase/Postgres) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Service ---
PORT=
