{
  "name": "codeforge-quality-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Code Quality Analysis Engine for CodeForge AI — deterministic static analysis plus an AI semantic-interpretation layer. Built to be dropped into the existing CodeForge repo.",
  "main": "dist/api/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/src/parsers/python && cp src/parsers/python/extract_ast.py dist/src/parsers/python/extract_ast.py",
    "test": "jest --runInBand",
    "demo": "ts-node scripts/demo.ts",
    "start": "node dist/api/server.js",
    "dev": "ts-node src/api/server.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/express": "^4.17.21"
  }
}
