# CodeForge AI — Adaptive Challenge Engine (Feature 25)
# All values intentionally left blank — fill in against your real
# environment before wiring this to a live database or AI provider.
# Nothing in src/engine/** requires any of these to run; they're only
# needed once the in-memory adapters (src/integration/inMemoryAdapters.ts)
# are swapped for real ones.

# --- Existing CodeForge infrastructure (ASSUMED names — confirm against the real repo) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# --- AI providers ---
# Used ONLY for optional semantic tagging / generated-variant support /
# explanation prose polish. The selector itself is fully deterministic and
# does not call any of these to produce a recommendation (see spec: "Cost
# Control" — no LLM call on the selection hot path).
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Engine configuration ---
ADAPTIVE_ENGINE_SELECTOR_VERSION=selector-v1
ADAPTIVE_ENGINE_WEIGHTS_VERSION=weights-v1
