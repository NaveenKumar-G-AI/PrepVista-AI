# Supabase (reuse the project's existing values - do not create a new project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (reuse the project's existing provider abstraction/keys if one exists)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Feature flags
DEBUGGING_COACH_ENABLED=true
DEBUGGING_COACH_AI_TIMEOUT_MS=8000
