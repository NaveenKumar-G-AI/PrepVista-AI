# Copy this file to .env and fill in the blanks. Nothing in this repo
# ships with real credentials — every secret below is intentionally
# empty so you can drop your own in.

# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Persistence ────────────────────────────────────────────────────
# "memory" runs the whole service in-process with zero external
# infrastructure — good for local dev, demos, and CI. Switch to
# "postgres" (and fill in DATABASE_URL) once you're ready for real
# persistence. See prisma/schema.prisma + src/repositories/.
DATABASE_PROVIDER=memory
DATABASE_URL="postgresql://codeforge:codeforge@localhost:5432/codeforge_feature36?schema=public"

# ── Cache / Queue ──────────────────────────────────────────────────
# Same idea: "memory" needs nothing running. Switch to "redis" /
# "bullmq" for multi-instance / production deployments and set
# REDIS_URL. docker-compose.yml spins up a local Redis if you want one.
CACHE_PROVIDER=memory
QUEUE_PROVIDER=memory
REDIS_URL=

# ── Auth ───────────────────────────────────────────────────────────
# Required to run the server at all (even in memory mode) — the API
# always requires a signed bearer token. Put your own signing secret
# here. In production this should be replaced by validating against
# CodeForge's real identity service — see IdentityPort in
# src/integrations/ports.ts.
JWT_SECRET=
JWT_ISSUER=codeforge

# ── AI-grounded narrative summaries (optional, section 54-56) ───────
# Leave AI_PROVIDER=none to disable narrative summaries entirely.
# All structured analytics work fully without this — AI is optional
# enrichment on top, never the source of truth.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# ── Privacy policy defaults (section 31, 62) ─────────────────────────
# Per-organization overrides are stored in OrganizationPrivacyPolicy;
# these are just the defaults used until an org sets its own.
PRIVACY_MIN_COHORT_SIZE=10
PRIVACY_MIN_COVERAGE_FOR_CLAIM=0.3

# ── Integrations (section 9, 15, 20, 54) ─────────────────────────────
# Feature 36 never recomputes mastery/readiness/growth itself — it
# consumes existing CodeForge systems through the ports in
# src/integrations/ports.ts. USE_MOCK_INTEGRATIONS=true wires in
# deterministic fake adapters so the service is fully runnable before
# (or without) those systems being connected. Flip to "false" once you
# implement real adapters in src/integrations/index.ts.
USE_MOCK_INTEGRATIONS=true
