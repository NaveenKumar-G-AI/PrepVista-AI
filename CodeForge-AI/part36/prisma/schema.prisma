generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// Feature 36 — College Cohort Technical Intelligence
//
// This schema owns ONLY the cohort-intelligence bounded context.
// organizationId, studentId, skillId, and roleId are opaque external
// references into CodeForge's existing services (Organization/Tenant
// service, Student service, Skill Signal Engine, Role Readiness
// Engine). We deliberately do NOT model those entities here — see
// docs/ARCHITECTURE.md and src/integrations/ports.ts for why, and for
// the adapter boundary where real integrations get wired in.
// ─────────────────────────────────────────────────────────────────

enum CohortKind {
  ACADEMIC
  DEPARTMENT
  TRAINING
  ROLE
  PLACEMENT
  CUSTOM
}

enum CohortDimension {
  ACADEMIC_YEAR
  BATCH
  DEPARTMENT
  DEGREE
  BRANCH
  SECTION
  GRADUATION_YEAR
  PLACEMENT_CYCLE
  TRAINING_PROGRAM
  ROLE_TRACK
  CUSTOM
}

enum MasteryLevel {
  NOT_ASSESSED
  EMERGING
  DEVELOPING
  PROFICIENT
  STRONG
}

enum EvidenceCoverageState {
  INSUFFICIENT
  LOW
  MEDIUM
  HIGH
}

enum TrendDirection {
  IMPROVING
  STABLE
  DECLINING
  INSUFFICIENT_EVIDENCE
}

enum ReadinessState {
  READY
  NEAR_READY
  DEVELOPING
  NEEDS_SIGNIFICANT_PREPARATION
  INSUFFICIENT_EVIDENCE
}

enum GapPriority {
  HIGH
  MODERATE
  EMERGING
  INSUFFICIENT_EVIDENCE
}

enum IntelligenceEventType {
  ASSESSMENT_COMPLETED
  INTERVIEW_COMPLETED
  SKILL_EVIDENCE_UPDATED
  PROJECT_EVALUATED
}

enum IntelligenceEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model CohortDefinition {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  kind           CohortKind
  dimension      CohortDimension
  parentCohortId String?
  parentCohort   CohortDefinition?  @relation("CohortHierarchy", fields: [parentCohortId], references: [id])
  children       CohortDefinition[] @relation("CohortHierarchy")
  attributes     Json               @default("{}")
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  memberships      CohortMembership[]
  skillAggregates  CohortSkillAggregate[]
  roleAggregates   CohortRoleAggregate[]
  trainingInsights CohortTrainingInsight[]
  snapshots        CohortSnapshot[]
  events           CohortIntelligenceEvent[]

  @@index([organizationId])
  @@index([organizationId, kind])
  @@index([organizationId, isActive])
}

model CohortMembership {
  id             String    @id @default(cuid())
  organizationId String
  cohortId       String
  cohort         CohortDefinition @relation(fields: [cohortId], references: [id])
  studentId      String
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  isActive       Boolean   @default(true)

  @@unique([cohortId, studentId])
  @@index([organizationId, studentId])
  @@index([cohortId, isActive])
}

model CohortSkillAggregate {
  id                   String                @id @default(cuid())
  organizationId       String
  cohortId             String
  cohort               CohortDefinition      @relation(fields: [cohortId], references: [id])
  skillId              String
  skillName            String
  eligibleStudents     Int
  studentsWithEvidence Int
  coveragePct          Float
  coverageState        EvidenceCoverageState
  distribution         Json
  dominantLevel        MasteryLevel?
  trend                TrendDirection        @default(INSUFFICIENT_EVIDENCE)
  confidence           Float
  sourceVersion        String
  computedAt           DateTime              @default(now())

  @@index([organizationId, cohortId])
  @@index([cohortId, skillId, computedAt])
}

model CohortRoleAggregate {
  id                    String                @id @default(cuid())
  organizationId        String
  cohortId              String
  cohort                CohortDefinition      @relation(fields: [cohortId], references: [id])
  roleId                String
  roleName              String
  eligibleStudents      Int
  studentsWithEvidence  Int
  coveragePct           Float
  coverageState         EvidenceCoverageState
  readinessDistribution Json
  requiredSkillGaps     Json
  trend                 TrendDirection        @default(INSUFFICIENT_EVIDENCE)
  confidence            Float
  sourceVersion         String
  computedAt            DateTime              @default(now())

  @@index([organizationId, cohortId])
  @@index([cohortId, roleId, computedAt])
}

model CohortTrainingInsight {
  id                     String           @id @default(cuid())
  organizationId         String
  cohortId               String
  cohort                 CohortDefinition @relation(fields: [cohortId], references: [id])
  skillId                String?
  roleId                 String?
  label                  String
  gapPriority            GapPriority
  interventionCategories Json
  affectedStudents       Int
  rationale              Json
  priorityRank           Int
  sourceVersion          String
  computedAt             DateTime         @default(now())

  @@index([organizationId, cohortId])
  @@index([cohortId, priorityRank])
}

model CohortSnapshot {
  id                        String           @id @default(cuid())
  organizationId            String
  cohortId                  String
  cohort                    CohortDefinition @relation(fields: [cohortId], references: [id])
  periodLabel                String
  periodStart               DateTime
  periodEnd                 DateTime
  payload                   Json
  scoringMethodologyVersion String
  createdAt                 DateTime         @default(now())

  @@unique([cohortId, periodLabel])
  @@index([organizationId, cohortId])
}

model CohortIntelligenceEvent {
  id              String                  @id @default(cuid())
  organizationId  String
  studentId       String
  cohortId        String?
  cohort          CohortDefinition?       @relation(fields: [cohortId], references: [id])
  eventType       IntelligenceEventType
  sourceEventId   String                  @unique
  sourceTimestamp DateTime
  payload         Json
  status          IntelligenceEventStatus @default(PENDING)
  processedAt     DateTime?
  failureReason   String?
  createdAt       DateTime                @default(now())

  @@index([organizationId, status])
  @@index([studentId])
}

model AuditLogEntry {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String
  actorRole      String
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

model OrganizationPrivacyPolicy {
  organizationId      String   @id
  minCohortSize       Int      @default(10)
  minCoverageForClaim Float    @default(0.3)
  updatedAt           DateTime @updatedAt
}
