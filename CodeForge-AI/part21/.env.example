# CodeForge AI — Understanding Check
# Copy this file to .env (or merge into your existing CodeForge .env) and fill in your own values.
# Nothing here is pre-filled — the code reads these at call time and throws a clear
# configuration error if a required one is missing, rather than failing silently.

# --- AI providers (at least one required; Groq is tried first, Gemini second) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Database (Supabase/Postgres) ---
# Used by your own AssessmentRepository implementation (see db/migrations/0001_understanding_check.sql
# and the AssessmentRepository interface in src/api/controllers.ts) — not read directly by this
# package, since it ships with a framework-agnostic in-memory reference implementation instead.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
