# Left blank on purpose — fill these in yourself, nothing here is a real credential.

# Required for the AI explanation layer (src/ai/explainReadiness.ts).
# Without this set, explainReadiness() automatically falls back to the
# deterministic template explanation — it never blocks readiness results.
ANTHROPIC_API_KEY=

# Optional — defaults to a cost-efficient model since this is a high-volume,
# low-complexity "explain this JSON" task, not open-ended reasoning.
# Swap to a stronger model here if you want richer explanations.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Wire this to your actual Postgres/Supabase connection once you adapt
# db/migrations/001_role_readiness.sql to your real schema.
DATABASE_URL=
