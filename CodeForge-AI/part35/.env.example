# Postgres connection for the service-role repository (BYPASSRLS).
# The migration creates app_conn_service with password 'localdevpw' for
# LOCAL DEV ONLY — replace both the role and password before anything
# resembling production.
DATABASE_URL=postgres://app_conn_service:@localhost:5432/codeforge_dev

# Left blank on purpose. Without it, src/api/server.ts falls back to
# SimulatedAIGateway (the same deterministic stand-in the test suite uses)
# so the API is still runnable with no external calls at all.
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile in aiGatewayAdapter.groq.ts.
AI_MODEL_ID=

PORT=8035
