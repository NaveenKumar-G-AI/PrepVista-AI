# Copy this file to .env and fill in real values before running against
# live providers or a live database. Everything below is intentionally
# blank/placeholder — see config.py, which reads these and raises loudly
# (only at the moment a value is actually needed) rather than silently
# proceeding with an empty secret.

CODEFORGE_ENV=development

# --- AI provider credentials (leave blank until you have real keys) -------
GROQ_API_KEY=
GEMINI_API_KEY=

# Only needed if you want to override the default vendor endpoints
# (e.g. to point at a proxy). Safe to leave unset.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Database (point this at your Supabase/Postgres project) --------------
# After applying db/migrations/0001_init.sql and 0002_rls.sql, connect as
# the RLS-enforced role for normal gateway traffic:
DATABASE_URL=

# Only needed for the cross-organization admin dashboards in admin_api.py
# (role created by migration 0002, BYPASSRLS):
ADMIN_DATABASE_URL=

# --- Redis (caching, rate limiting) ----------------------------------------
REDIS_URL=

# --- Admin control plane -----------------------------------------------------
# A long random string. The admin API (admin_api.py) refuses to serve any
# request, including reads, until this is set — see require_admin_api_token().
ADMIN_API_TOKEN=
