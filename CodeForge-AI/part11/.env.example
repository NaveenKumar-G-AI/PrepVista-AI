# ============================================================
# CodeForge Incident Engine — environment configuration
# Copy this file to .env.local and fill in the blanks.
# Nothing in this file is a working credential — every value
# below is intentionally left empty for you to fill in.
# ============================================================

# --- Supabase project (Settings -> API in your Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser / NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Direct Postgres connection (Settings -> Database -> Connection string) ---
# Used by the API route handlers / repo layer for the incident engine's
# relational writes (state machine, actions, evaluations, evidence).
# Example: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# --- AI coaching (optional — the simulation runs fully without this) ---
# Only ONE of these is required. Set AI_PROVIDER to pick which.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# If both keys above are empty, /api/incidents/[id]/evaluation still works —
# it returns the deterministic scores with a templated (non-AI) coaching
# summary instead of calling out to an LLM. See src/lib/engine/aiCoaching.ts.
